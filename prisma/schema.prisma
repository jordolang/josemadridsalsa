model GiftCertificate {
  id              String                @id @default(cuid())
  code            String                 @unique // e.g., "JMS-GC-XXXX-XXXX"
  
  // Purchase info
  orderId         String?                // Link to order that created this
  order           Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  // Amounts
  originalAmount  Decimal                @db.Decimal(10, 2)
  balance         Decimal                @db.Decimal(10, 2)
  
  // Purchaser info
  purchaserName   String
  purchaserEmail  String
  
  // Recipient info
  recipientName   String
  recipientEmail  String?
  
  // Gift certificate details
  theme           GiftCertificateTheme
  message         String?
  
  // Status
  status          GiftCertificateStatus  @default(ACTIVE)
  
  // Expiration (optional)
  expiresAt       DateTime?
  
  // Timestamps
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  redeemedAt      DateTime?
  
  // Relations
  usages          GiftCertificateUsage[]
  
  @@index([code])
  @@index([purchaserEmail])
  @@index([recipientEmail])
  @@index([status])
  @@index([orderId])
  @@map("gift_certificates")
}

