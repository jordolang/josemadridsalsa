model EmailConfiguration {
  id              String   @id @default(cuid())
  name            String   // e.g., "Primary SMTP", "Backup Server"
  
  // SMTP settings
  smtpHost        String?
  smtpPort        Int?     @default(587)
  smtpUsername    String?
  smtpPassword    String?  @db.Text  // Encrypted
  smtpSecure      Boolean  @default(true)  // Use TLS
  
  // Sender info
  fromEmail       String
  fromName        String?
  replyToEmail    String?
  
  // Settings
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  useResend       Boolean  @default(true)  // Fallback to Resend
  
  // Rate limiting
  maxPerHour      Int      @default(1000)
  maxPerDay       Int      @default(10000)
  
