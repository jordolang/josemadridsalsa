  @@map("email_configurations")
}

model EmailCampaign {
  id              String              @id @default(cuid())
  name            String
  
  // Template
  templateId      String
  template        EmailTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  
  // Campaign details
  subject         String              // Can override template subject
  status          EmailCampaignStatus @default(DRAFT)
  
  // Scheduling
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  
  // Tracking
  totalRecipients Int                 @default(0)
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  bouncedCount    Int                 @default(0)
  
  // Settings
  trackOpens      Boolean             @default(false)
  trackClicks     Boolean             @default(false)
  
  // Metadata
  notes           String?             @db.Text
  createdById     String?
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  // Relations
  recipients      EmailRecipient[]
  
  @@index([status])
  @@index([scheduledAt])
  @@index([createdById])
  @@map("email_campaigns")
}

model EmailRecipient {
  id              String                @id @default(cuid())
  campaignId      String
  campaign        EmailCampaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  // Recipient info
