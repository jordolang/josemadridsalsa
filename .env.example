# Database Configuration
# =======================
# Production Neon Database
DATABASE_URL='your_database_url_here'

# Local PostgreSQL (uncomment for local development)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/josemadridsalsa"

# NextAuth.js
# For production, use your domain. For local development, use http://localhost:3000
NEXTAUTH_URL="https://www.josemadrid.net"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Encryption
# =======================
# Master key for admin panel encryption (legacy)
MASTER_KEY="your_master_key_here"

# Encryption key for sensitive data (SMTP passwords, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
ENCRYPTION_KEY="your_encryption_key_here"

# Google OAuth (optional)
# Also used for Google Business posting (GOOGLE_MY_BUSINESS) in the social dashboard.
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Social Media Publishing (Admin → Social)
# =======================
# EASIEST PATH — "Easy mode" via Ayrshare (no developer apps, free tier):
# Sign up free at ayrshare.com, click-connect your social accounts there, and
# either paste the API key in the admin panel (Social → Accounts → Easy mode)
# or set it here. When present, all posting routes through Ayrshare and you can
# ignore every per-platform key below.
AYRSHARE_API_KEY="your_ayrshare_api_key_here"
#
# OR the direct path (free, but you register a developer app per platform).
# All of these can also be entered in the admin panel instead of here.
# These power one-click connecting + posting to each platform from the admin
# panel. You only set them ONCE. Each value comes from a developer app you
# register with that platform — the admin "Accounts" tab shows step-by-step
# setup instructions and the exact Redirect URI to paste into each console.
# Leave a platform's vars blank to keep it cleanly marked "Setup required"
# in the dashboard (it will not pretend to be connected).
#
# Facebook + Instagram (one Facebook Business app powers both):
#   developers.facebook.com → create app → add Facebook Login
FACEBOOK_APP_ID="your_facebook_app_id_here"
FACEBOOK_APP_SECRET="your_facebook_app_secret_here"
#
# Live tab (auto-detects when the Facebook Page is broadcasting and lights up the
# "Live" nav tab with a green blinking circle linking to /live). Both must be set
# for detection; leave blank and the Live tab simply links to the Facebook page.
#   FACEBOOK_LIVE_PAGE_ID            numeric Page ID (Page → About → Page transparency)
#   FACEBOOK_LIVE_PAGE_ACCESS_TOKEN  long-lived Page access token (Graph API Explorer →
#                                    pages_read_engagement → exchange for a long-lived token)
FACEBOOK_LIVE_PAGE_ID=""
FACEBOOK_LIVE_PAGE_ACCESS_TOKEN=""
# Public Facebook page URL — offline fallback target for the Live tab.
NEXT_PUBLIC_FACEBOOK_PAGE_URL="https://www.facebook.com/josemadridsalsainc"
# X / Twitter (OAuth 2.0 web app with Read+Write):
#   developer.x.com → Project + App → OAuth 2.0
TWITTER_CLIENT_ID="your_twitter_client_id_here"
TWITTER_CLIENT_SECRET="your_twitter_client_secret_here"
# TikTok (Login Kit + Content Posting API):
#   developers.tiktok.com → create app
TIKTOK_CLIENT_KEY="your_tiktok_client_key_here"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret_here"
# Google Business uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above
# (enable the Business Profile API for the project).
#
# Optional: protects the scheduled-post cron endpoint. If set, the cron caller
# must send "Authorization: Bearer <value>". Vercel Cron sends this automatically.
CRON_SECRET="your_cron_secret_here"

# Google Maps & Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here" # Required for location map and "Where is Jose" schedule map - billing must be enabled
GOOGLE_PLACES_API_KEY="your_google_places_api_key_here" # Required for reviews
NEXT_PUBLIC_GOOGLE_PLACE_ID="" # Optional - Google Place ID for better map accuracy
GOOGLE_PLACE_ID="" # Optional - Google Place ID for Jose Madrid Salsa
GOOGLE_PLACE_NAME="Jose Madrid Salsa" # Business name for place search fallback
NEXT_PUBLIC_GOOGLE_STREETVIEW_PANO="" # Optional - Specific Street View panorama ID to use

# Google Service Account (for Calendar API)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your_service_account_email_here"
GOOGLE_SERVICE_ACCOUNT_NAME="your_service_account_name_here"
GOOGLE_SERVICE_ACCOUNT_ID="your_service_account_id_here"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="your_service_account_private_key_here" # Required for calendar API - include \\n for newlines

# Google Calendar (for "Where is Jose" public schedule)
GOOGLE_CALENDAR_ID="your_calendar_id_here" # The Google Calendar ID to display
GOOGLE_CALENDAR_IMPERSONATED_USER="" # Optional - User to impersonate for calendar access

# Stripe
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend)
RESEND_API_KEY="re_..."
FROM_EMAIL="mike@josemadridsalsa.com"
SERVICE_API_KEY="your_service_api_key_here" # For internal service-to-service authentication

# File Upload (UploadThing)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# Analytics
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_AMPLITUDE_API_KEY="your_amplitude_api_key_here"

# GrowthBook (feature flags & experiments)
# Get these from https://app.growthbook.io/sdks — one SDK Connection per environment.
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY="sdk-xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_GROWTHBOOK_API_HOST="https://cdn.growthbook.io"

# Shipping API Configuration
# ============================
# Real-time carrier rates via EasyPost or Shippo
# Get API keys from: https://www.easypost.com or https://goshippo.com

# Shipping provider selection (required)
SHIPPING_PROVIDER="easypost" # Options: easypost, shippo

# API key for your shipping provider (required)
SHIPPING_API_KEY="your_shipping_api_key_here"

# Test mode - uses sandbox API for development (required)
SHIPPING_TEST_MODE="true" # Set to false for production

# Origin address for shipping calculations (required)
# Used as fallback when admin settings don't specify an origin
SHIPPING_ORIGIN_ADDRESS="123 Main St"
SHIPPING_ORIGIN_CITY="San Francisco"
SHIPPING_ORIGIN_STATE="CA"
SHIPPING_ORIGIN_ZIP="94111"

# Vercel KV (Upstash Redis for distributed rate limiting)
# =======================
# Required for rate limiting in production (serverless environments)
# Get these from Vercel dashboard > Storage > KV > Connection
KV_REST_API_URL="your_kv_rest_api_url_here"
KV_REST_API_TOKEN="your_kv_rest_api_token_here"

# Other
# NODE_ENV is automatically set by Next.js - don't override it
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
