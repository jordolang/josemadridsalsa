# Database Configuration
# =====================
# IMPORTANT: The schema uses PostgreSQL. You need a working PostgreSQL database.
#
# Option 1: Prisma Accelerate (Recommended for development if you have access)
# DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=YOUR_API_KEY_HERE"
#
# Option 2: Direct PostgreSQL connection
# DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"
#
# Option 3: Local PostgreSQL (if running locally)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/josemadridsalsa?schema=public"

DATABASE_URL="postgresql://localhost:5432/josemadridsalsa"
POSTGRES_URL=""
PRISMA_DATABASE_URL=""
PRISMA_TOKEN=""

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Encryption (Admin Panel)
MASTER_KEY="your-master-key-here"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Maps & Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_PLACES_API_KEY=""
NEXT_PUBLIC_GOOGLE_PLACE_ID=""
GOOGLE_PLACE_ID=""
GOOGLE_PLACE_NAME="Jose Madrid Salsa"
NEXT_PUBLIC_GOOGLE_STREETVIEW_PANO=""

# Google Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_NAME=""
GOOGLE_SERVICE_ACCOUNT_ID=""

# Stripe
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend)
RESEND_API_KEY="re_..."
FROM_EMAIL="orders@josemadridsalsa.com"

# File Upload (UploadThing)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# Analytics
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Other
NODE_ENV="development"
