# Database Configuration
# =======================
# Production Database — Supabase (PostgreSQL)
# Get these from: Supabase Dashboard → Project Settings → Database → Connection string.
#   DATABASE_URL          → Transaction pooler (port 6543). Used by the app at runtime on serverless.
#   DATABASE_URL_UNPOOLED → Session pooler (port 5432). Used by Prisma for migrations (datasource directUrl).
# Replace [PROJECT_REF], [PASSWORD], and [REGION] with your project's values.
DATABASE_URL='postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1'
DATABASE_URL_UNPOOLED='postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres'

# Local PostgreSQL (uncomment for local development)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/josemadridsalsa"
# DATABASE_URL_UNPOOLED="postgresql://postgres:password@localhost:5432/josemadridsalsa"

# NextAuth.js
# For production, use your domain. For local development, use http://localhost:3000
NEXTAUTH_URL="https://www.josemadrid.net"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Encryption
# =======================
# Master key for admin panel encryption (legacy)
MASTER_KEY="your_master_key_here"

# Encryption key for sensitive data (SMTP passwords, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
ENCRYPTION_KEY="your_encryption_key_here"

# QuickBooks Online (Admin → Settings → Integrations)
# =======================
# Optional: these can also be entered (and encrypted) in the admin panel instead
# of here. Register an app at https://developer.intuit.com (Dashboard → your app
# → Keys & credentials) and set the Redirect URI to:
#   {NEXTAUTH_URL}/api/integrations/quickbooks/callback
# Use the Development keys with QUICKBOOKS_ENVIRONMENT=sandbox, then swap to the
# Production keys with QUICKBOOKS_ENVIRONMENT=production when going live.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_ENVIRONMENT="sandbox"

# Google OAuth (optional)
# Also used for Google Business posting (GOOGLE_MY_BUSINESS) in the social dashboard.
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Social Media Publishing (Admin → Social)
# =======================
# You register a developer app per platform (free).
# All of these can also be entered in the admin panel instead of here.
# These power one-click connecting + posting to each platform from the admin
# panel. You only set them ONCE. Each value comes from a developer app you
# register with that platform — the admin "Accounts" tab shows step-by-step
# setup instructions and the exact Redirect URI to paste into each console.
# Leave a platform's vars blank to keep it cleanly marked "Setup required"
# in the dashboard (it will not pretend to be connected).
#
# Facebook + Instagram (one Facebook Business app powers both):
#   developers.facebook.com → create app → add Facebook Login
FACEBOOK_APP_ID="your_facebook_app_id_here"
FACEBOOK_APP_SECRET="your_facebook_app_secret_here"
#
# Live tab (auto-detects when the Facebook Page is broadcasting and lights up the
# "Live" nav tab with a green blinking circle linking to /live). Both must be set
# for detection; leave blank and the Live tab simply links to the Facebook page.
#   FACEBOOK_LIVE_PAGE_ID            numeric Page ID (Page → About → Page transparency)
#   FACEBOOK_LIVE_PAGE_ACCESS_TOKEN  long-lived Page access token (Graph API Explorer →
#                                    pages_read_engagement → exchange for a long-lived token)
FACEBOOK_LIVE_PAGE_ID=""
FACEBOOK_LIVE_PAGE_ACCESS_TOKEN=""
# Public Facebook page URL — offline fallback target for the Live tab.
NEXT_PUBLIC_FACEBOOK_PAGE_URL="https://www.facebook.com/josemadridsalsainc"
# X / Twitter (OAuth 2.0 web app with Read+Write):
#   developer.x.com → Project + App → OAuth 2.0
TWITTER_CLIENT_ID="your_twitter_client_id_here"
TWITTER_CLIENT_SECRET="your_twitter_client_secret_here"
# TikTok (Login Kit + Content Posting API):
#   developers.tiktok.com → create app
TIKTOK_CLIENT_KEY="your_tiktok_client_key_here"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret_here"
# Google Business uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above
# (enable the Business Profile API for the project).
#
# Amazon listing sync (Feeds → Shops → Amazon). Create a self-authorized SP-API
# app in Seller Central → Apps & Services → Develop Apps; all four are required.
AMAZON_SP_API_CLIENT_ID=""
AMAZON_SP_API_CLIENT_SECRET=""
AMAZON_SP_API_REFRESH_TOKEN=""
AMAZON_SP_API_SELLER_ID=""
# Optional overrides — default to the US marketplace on the NA endpoint.
AMAZON_SP_API_MARKETPLACE_ID=""
AMAZON_SP_API_ENDPOINT=""
#
# Google Shopping listing sync (Feeds → Shops → Google Shopping). Create a
# service account with the Merchant API enabled (the Content API for Shopping
# was sunset), then add its email as a user in Merchant Center settings. Private key is PEM (\n-escaped OK).
GOOGLE_MERCHANT_CENTER_ID=""
GOOGLE_MERCHANT_DATA_SOURCE_ID=""
GOOGLE_SHOPPING_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SHOPPING_SERVICE_ACCOUNT_PRIVATE_KEY=""
TIKTOK_SHOP_APP_KEY=""
TIKTOK_SHOP_APP_SECRET=""
TIKTOK_SHOP_REFRESH_TOKEN=""
#
# Optional: protects the scheduled-post cron endpoint. If set, the cron caller
# must send "Authorization: Bearer <value>". Vercel Cron sends this automatically.
CRON_SECRET="your_cron_secret_here"

# Google Maps & Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here" # Required for location map and "Where is Jose" schedule map - billing must be enabled
GOOGLE_PLACES_API_KEY="your_google_places_api_key_here" # Required for reviews
NEXT_PUBLIC_GOOGLE_PLACE_ID="" # Optional - Google Place ID for better map accuracy
GOOGLE_PLACE_ID="" # Optional - Google Place ID for Jose Madrid Salsa
GOOGLE_PLACE_NAME="Jose Madrid Salsa" # Business name for place search fallback
NEXT_PUBLIC_GOOGLE_STREETVIEW_PANO="" # Optional - Specific Street View panorama ID to use

# Server-side Maps key for geocoding locations (lib/geocoding.ts). Geocoding throws without it.
GOOGLE_MAPS_API_KEY=""

# Google Service Account (for Calendar API)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your_service_account_email_here"
GOOGLE_SERVICE_ACCOUNT_NAME="your_service_account_name_here"
GOOGLE_SERVICE_ACCOUNT_ID="your_service_account_id_here"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="your_service_account_private_key_here" # Required for calendar API - include \\n for newlines

# Google Calendar (for "Where is Jose" public schedule)
GOOGLE_CALENDAR_API_KEY="" # Required with GOOGLE_CALENDAR_ID for the public schedule; the calendar must be public
GOOGLE_CALENDAR_ID="your_calendar_id_here" # The Google Calendar ID to display
GOOGLE_CALENDAR_IMPERSONATED_USER="" # Optional - User to impersonate for calendar access

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend)
RESEND_API_KEY="re_..."
FROM_EMAIL="mike@josemadridsalsa.com"
# Absolute base URL for email header/footer images (no trailing slash).
# Defaults to https://www.josemadrid.net/email-templates
EMAIL_IMAGE_BASE_URL=""
SERVICE_API_KEY="your_service_api_key_here" # For internal service-to-service authentication

# File Upload (UploadThing)
# UploadThing v7 token (dashboard > API Keys > V7 tab)
UPLOADTHING_TOKEN=""

# Vercel Blob — image and file hosting for the josemadridsalsa-blob store.
# Powers /admin/developer/files, the product image uploader, and the
# images:sync / images:migrate scripts. Vercel > Storage > josemadridsalsa-blob.
# Without it every blob upload path is disabled and returns 503.
BLOB_READ_WRITE_TOKEN=""

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_AMPLITUDE_API_KEY="your_amplitude_api_key_here"

# Shipping API Configuration
# ============================
# Real-time carrier rates via EasyPost or Shippo
# Get API keys from: https://www.easypost.com or https://goshippo.com

# Shipping provider selection (required)
SHIPPING_PROVIDER="easypost" # Options: easypost, shippo

# API key for your shipping provider (required)
SHIPPING_API_KEY="your_shipping_api_key_here"

# Test mode - uses sandbox API for development (required)
SHIPPING_TEST_MODE="true" # Set to false for production

# Origin address for shipping calculations (required)
# Used as fallback when admin settings don't specify an origin
SHIPPING_ORIGIN_ADDRESS="123 Main St"
SHIPPING_ORIGIN_CITY="San Francisco"
SHIPPING_ORIGIN_STATE="CA"
SHIPPING_ORIGIN_ZIP="94111"

# Vercel KV (Upstash Redis for distributed rate limiting)
# =======================
# Required for rate limiting in production (serverless environments)
# Get these from Vercel dashboard > Storage > KV > Connection
KV_REST_API_URL="your_kv_rest_api_url_here"
KV_REST_API_TOKEN="your_kv_rest_api_token_here"

# Lead Generation Scraper
# =======================
# The lead-gen pipeline (admin > Lead Generation) has two swappable stages:
# a SERP/search provider and a browser/HTML provider. Bright Data is preferred
# when set; otherwise it falls back to SerpAPI + Browserless/local Chromium.
#
# --- Bright Data (preferred) ---
# Scraping Browser: full CDP wss endpoint. Upgrades BOTH search scraping and
# website contact-parsing to bypass CAPTCHAs/bot detection. Get it from the
# Bright Data dashboard > Scraping Browser > Access parameters.
#   Format: wss://brd-customer-<id>-zone-<zone>:<password>@brd.superproxy.io:9222
BRIGHTDATA_BROWSER_URL=""
# Unified API token for Web Unlocker + SERP API (dashboard > Account settings > API).
BRIGHTDATA_API_KEY=""
# Zone names for the Web Unlocker and SERP products (dashboard > Proxies & Scraping).
BRIGHTDATA_UNLOCKER_ZONE="web_unlocker"
BRIGHTDATA_SERP_ZONE="serp_api"
#
# --- Fallback providers ---
# SerpAPI: structured Google/Maps results (https://serpapi.com, free tier available).
SERPAPI_KEY=""
# Browserless.io: hosted headless Chromium for the parse stage (https://browserless.io).
BROWSERLESS_TOKEN=""

# Other
# NODE_ENV is automatically set by Next.js - don't override it
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# PayPal & Square (browser-side)
# =======================
# Public ids the checkout buttons load with. A missing value hides that payment option.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
NEXT_PUBLIC_SQUARE_APP_ID=""
NEXT_PUBLIC_SQUARE_LOCATION_ID=""

# Staff notifications
# =======================
# Comma-separated inboxes. ORDER_NOTIFICATION_EMAILS gets new-order alerts
# (falls back to INVENTORY_ALERT_EMAILS); INVENTORY_ALERT_EMAILS gets low-stock alerts.
ORDER_NOTIFICATION_EMAILS=""
INVENTORY_ALERT_EMAILS=""
SUPPORT_EMAIL="" # Where customer message threads are forwarded
FUNDRAISING_EMAIL="" # Inbox for fundraiser sign-ups and fundraising-site order submissions
SYSTEM_OWNER_EMAIL="" # Account that owns system-created forms
NEXT_PUBLIC_FROM_EMAIL="" # Sender for queued bulk email; falls back to FROM_EMAIL

# Public contact details & links (all have built-in defaults)
# =======================
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_PHONE=""
NEXT_PUBLIC_HQ_LOCATION=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=""
GOOGLE_REVIEW_URL="" # Review link on the order-confirmation page
NEXT_PUBLIC_FULFILLMENT_EMAIL="" # Merchandise fulfillment partner contact
NEXT_PUBLIC_FULFILLMENT_PARTNER=""
NEXT_PUBLIC_FULFILLMENT_PORTAL_URL=""
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED="" # "true" loads Vercel Analytics on public pages

# Fundraising & arena
# =======================
# HMAC secret for the machine-to-machine POST /api/fundraiser/sale endpoint
FUNDRAISER_API_SECRET=""
# Signs arena share-shield nonces. At least 32 characters; share links fail without it.
ARENA_SHARE_SECRET=""
# Origin of the fundraising app (apps/fundraising). The main site sends its old fundraiser paths here.
NEXT_PUBLIC_FUNDRAISING_SITE_URL=""
# Base URL for fundraiser approval, share and donation links. Falls back to the request origin.
APP_URL=""

# Admin & internal
# =======================
ADMIN_SECRET_TOKEN="" # Optional: an `admin_token` cookie with this value is treated as an admin session. Leave unset in production.
IMPORT_SECRET="" # Required by /api/import-locations-secret; unset disables it
EMAIL_CHUNK_BUDGET_MS="" # Queue worker time budget per run (default 45000)
EMAIL_SEND_DELAY_MS="" # Delay between queued sends (default 550)

# AI chat — SmileyFace provider (only when AI_CHAT_PROVIDER=smileyface)
SMILEYFACE_API_KEY=""
SMILEYFACE_API_BASE="" # Defaults to https://api.smileyface.ai/v1

# Developer console → salsadocs publishing (/admin/developer)
SALSADOCS_GITHUB_TOKEN=""
SALSADOCS_GITHUB_REPO="" # Defaults to jordolang/salsadocs
SALSADOCS_GITHUB_BRANCH="" # Defaults to main
SALSADOCS_CONTENT_DIR="" # Defaults to content/docs
