# EverShop Configuration

# Database Configuration
# Use the same PostgreSQL instance as your Next.js app, but with a separate schema
DB_HOST=localhost
DB_PORT=5432
DB_NAME=josemadridsalsa
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SCHEMA=evershop

# Server Configuration
# Use a different port to avoid conflicts with Next.js (default: 3000)
PORT=3001
HOST=localhost

# Admin User (created during setup)
ADMIN_EMAIL=admin@josemadridsalsa.com
ADMIN_PASSWORD=change_this_secure_password

# API Security
EVERSHOP_API_KEY=generate_a_secure_random_key_here

# Session Secret (for admin authentication)
SESSION_SECRET=generate_a_different_secure_key_here

# Integration with Next.js
NEXTJS_API_URL=http://localhost:3000/api
NEXTJS_WEBHOOK_SECRET=generate_another_secure_key_here

# Payment Gateways (if using EverShop's payment processing)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Shipping
SHIPPO_API_KEY=your_shippo_key_if_needed
