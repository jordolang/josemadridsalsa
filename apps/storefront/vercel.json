{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "touch .env .env.local .env.production .env.production.local .env.sentry-build-plugin .env.vercel.production && node scripts/generate-game-icons-manifest.mjs && npm run vercel-build",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/email-automation",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/email-campaigns",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/social-publish",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/abandoned-cart",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/quickbooks-sync",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/operations-sweep",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/processor-fees",
      "schedule": "30 */2 * * *"
    },
    {
      "path": "/api/cron/review-requests",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/fundraiser-lifecycle",
      "schedule": "0 13 * * *"
    }
  ]
}
