{
  "name": "@jose-madrid/storefront",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "api-keys:create": "tsx scripts/create-partner-api-key.ts",
    "auto-execute": "tsx scripts/auto-execute-session.ts",
    "build": "cross-env NODE_ENV=production next build",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "create-admin": "tsx scripts/create-admin.ts",
    "create-developer": "tsx scripts/promote-developer.ts",
    "credentials:grant-access": "tsx scripts/grant-credential-access.ts",
    "db:cleanup:fundraiser": "tsx scripts/cleanup-fundraiser-demo.ts",
    "db:deploy": "prisma migrate deploy",
    "db:diagnose": "node scripts/diagnose-db-connection.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:production:pull-env": "vercel env pull .env.vercel.production --environment=production --yes",
    "db:production:seed": "node scripts/seed-production.cjs",
    "db:production:sync": "node scripts/sync-production-schema.cjs",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:cms": "tsx scripts/seed-cms-demo.ts",
    "db:seed:email-templates": "tsx scripts/seed-email-templates.ts",
    "db:seed:fundraiser": "tsx scripts/seed-fundraiser-demo.ts",
    "db:seed:nutrition": "tsx scripts/seed-nutrition-ingredients.ts",
    "db:seed:permissions": "tsx prisma/seed.permissions.ts",
    "db:seed:recipes": "tsx scripts/seed-recipes.ts",
    "db:studio": "prisma studio",
    "db:sync": "prisma db push --skip-generate --accept-data-loss",
    "dev": "next dev --turbo --port 3000",
    "dev:debug": "next dev --turbo --inspect",
    "dev:fast": "next dev --turbo --port 3000",
    "email:mass-send": "tsx scripts/send-mass-email.ts",
    "email:repair-images": "tsx scripts/repair-email-template-images.ts",
    "fresh": "npm run clean && npm install && npm run dev",
    "fundraisers:build-contacts": "tsx scripts/build-fundraiser-contacts.ts",
    "images:migrate": "tsx scripts/migrate-site-images.ts",
    "images:sync": "tsx scripts/sync-images.ts",
    "ledger:backfill": "tsx scripts/backfill-ledger.ts",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "locations:geocode": "tsx scripts/backfill-location-coordinates.ts",
    "locations:import": "tsx scripts/import-locations-from-markdown.ts",
    "locations:photos": "node scripts/generate-location-photos.cjs",
    "locations:update-photos": "node scripts/update-location-photos.mjs",
    "locations:verify": "tsx scripts/verify-locations.ts",
    "postinstall": "prisma generate",
    "pre-commit": "lint-staged && npm run security:protect",
    "prebuild": "node scripts/sync-findus.cjs",
    "products:ensure-category": "tsx scripts/ensure-salsa-category.ts",
    "products:test-import": "tsx scripts/test-csv-import.ts",
    "products:transform": "tsx scripts/transform-products-csv.ts",
    "security:baseline": "gitleaks detect --source . --verbose --report-format json --report-path gitleaks-report.json",
    "security:protect": "gitleaks protect --verbose --redact --staged",
    "security:scan": "gitleaks detect --source . --verbose --redact",
    "start": "next start",
    "templates:backfill-owners": "tsx scripts/backfill-form-template-owners.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "vercel-build": "(prisma migrate deploy || echo 'WARN: prisma migrate deploy skipped (DB unreachable)') && prisma generate && (tsx prisma/seed.permissions.ts || echo 'WARN: seed.permissions skipped (DB unreachable)') && next build",
    "vercel:setup-env": "bash scripts/setup-vercel-env.sh",
    "version:feature": "tsx scripts/version-bump.ts feature",
    "version:increment": "tsx scripts/version-bump.ts increment",
    "version:major": "tsx scripts/version-bump.ts major"
  },
  "keywords": [
    "salsa",
    "e-commerce",
    "food",
    "next.js",
    "typescript"
  ],
  "author": "Jose Madrid Salsa",
  "license": "MIT",
  "dependencies": {
    "@amplitude/analytics-browser": "^2.33.1",
