  team           FundraiserTeam        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User?                 @relation("CharacterClaimant", fields: [userId], references: [id])
  sales          FundraiserSaleEvent[] @relation("CharacterSales")

  @@index([teamId])
  @@index([teamId, amountRaised(sort: Desc)])
  @@index([userId])
  @@map("fundraiser_characters")
}

model FundraiserSignupRequest {
  id            String                 @id @default(cuid())
  schoolName    String
  teamName      String
  contactName   String
  contactEmail  String
  contactPhone  String?
  goalAmount    Int                    @default(1000)
  message       String?
  status        FundraiserSignupStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNotes   String?
  apiKeyShownAt DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status])
  @@index([contactEmail])
  @@map("fundraiser_signup_requests")
}

model FundraiserSaleEvent {
  id                 String                        @id @default(cuid())
  teamId             String
  orderId            String?                       @unique
  amount             Decimal                       @default(0) @db.Decimal(10, 2)
  createdAt          DateTime                      @default(now())
  donorUserId        String?
  donorName          String?
  donorAvatarUrl     String?
  donorEmail         String?
  donorComment       String?
  isAnonymous        Boolean                       @default(false)
  sellingCharacterId String?
  reactions          FundraiserSaleEventReaction[]
  replies            FundraiserSaleEventReply[]
  donor              User?                         @relation(fields: [donorUserId], references: [id])
  sellingCharacter   FundraiserCharacter?          @relation("CharacterSales", fields: [sellingCharacterId], references: [id])
  team               FundraiserTeam                @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([donorUserId])
  @@index([sellingCharacterId])
  @@map("fundraiser_sale_events")
}

/// "Love" reaction on a sale-event (supporter feed item). Unique per
/// (saleEventId, userId) so a reaction POST is naturally idempotent and
/// DELETE lets the user toggle their own reaction.
model FundraiserSaleEventReaction {
  id          String              @id @default(cuid())
  saleEventId String
  userId      String
  createdAt   DateTime            @default(now())
  saleEvent   FundraiserSaleEvent @relation(fields: [saleEventId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([saleEventId, userId])
  @@index([saleEventId])
  @@index([userId])
  @@map("fundraiser_sale_event_reactions")
}

/// Threaded reply under a supporter-feed item. Authored by admins or the
/// owning team; the API layer gates who can POST. No edit/delete surface
/// yet — we can add soft-delete later if needed.
model FundraiserSaleEventReply {
  id           String              @id @default(cuid())
  saleEventId  String
  authorUserId String
  body         String
  createdAt    DateTime            @default(now())
  author       User                @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  saleEvent    FundraiserSaleEvent @relation(fields: [saleEventId], references: [id], onDelete: Cascade)

  @@index([saleEventId, createdAt])
  @@index([authorUserId])
  @@map("fundraiser_sale_event_replies")
}

model FundraiserShield {
  id          String         @id @default(cuid())
  teamId      String
  activatedAt DateTime       @default(now())
  expiresAt   DateTime
  remainingHP Int            @default(30)
  userId      String?
  team        FundraiserTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, expiresAt])
  @@map("fundraiser_shields")
}

model FundraiserShareEvent {
  id        String         @id @default(cuid())
  teamId    String
  userId    String
  platform  String         @default("facebook")
  createdAt DateTime       @default(now())
  team      FundraiserTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([userId, createdAt])
  @@map("fundraiser_share_events")
}

/// Single-use share-intent token issued by POST /arena/share/intent
/// and redeemed by GET /s/[nonce]. `nonce` is the HMAC-signed random
/// identifier that appears in the share URL. Single-use is enforced
/// via the unique constraint plus `consumedAt` set inside a tx.
model FundraiserShareNonce {
  id         String    @id @default(cuid())
  nonce      String    @unique
  userId     String
  teamId     String
  platform   String    @default("facebook")
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([userId, createdAt])
  @@index([teamId, createdAt])
  @@index([expiresAt])
  @@map("fundraiser_share_nonces")
}

/// Audit log of shield grants issued through the share flow. Used for
/// per-user / per-team rate-limit counts at redemption time (see
/// lib/arena/share-nonce.ts). Separate from FundraiserShareEvent which
/// records every share (including those that only extended an active
/// shield). A grant row is written only when a new shield is issued.
model FundraiserShieldGrant {
  id           String   @id @default(cuid())
  teamId       String
  userId       String
  platform     String   @default("facebook")
  diminishingN Int      @default(1)
  grantedAt    DateTime @default(now())

  @@index([userId, grantedAt])
  @@index([userId, platform, grantedAt])
  @@index([teamId, grantedAt])
  @@map("fundraiser_shield_grants")
}

model DeveloperBlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  tags        String[]  @default([])
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@map("developer_blog_posts")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("contact_submissions")
}

model DeveloperPageContent {
  id        String   @id @default(cuid())
  singleton String   @unique @default("singleton")
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("developer_page_content")
}

