// ---------------------------------------------------------------------------
// Document-archive imports
//
// Structured data recovered from the local (gitignored) `Documents/` business
// archive. Each row carries full provenance (source file + md5 + sheet/row) so
// an import is auditable and re-runnable, and so rows can be traced back to the
// spreadsheet they came from. See scripts/extract-mileage.py + import-mileage.ts.
// ---------------------------------------------------------------------------

/// A single business trip recovered from the yearly "Mileage Master" and
/// related spreadsheets in `01 Financial/Mileage`. The source files use four
/// different column layouts (some with odometer readings, some with computed
/// miles, some with a Sales column) and overlap heavily across re-exports, so
/// rows are normalized to this shape and de-duplicated on `contentHash`.
model MileageEntry {
  id            String           @id @default(cuid())
  /// Trip (start) date. Rows without a resolvable date are dropped at import.
  tripDate      DateTime
  /// End date for multi-day shows; null for a same-day trip.
  endDate       DateTime?
  /// Where the trip went — the "Vendor"/"Show"/"Location"/"Reason" cell.
  destination   String
  city          String?
  state         String?          @db.VarChar(4)
  /// Round-trip miles as recorded. Null when the source left it blank.
  miles         Int?
  /// One-way miles, when the sheet tracked it separately.
  oneWayMiles   Int?
  /// Odometer readings, present only in the driver-kept "Matt Mileage" sheets.
  odometerStart Int?
  odometerEnd   Int?
  /// Canonicalized driver name (Deb/Debbie -> "Debbie"; "?" -> null).
  driver        String?
  /// Booth/market sales recorded alongside the trip, when present.
  sales         Decimal?         @db.Decimal(10, 2)
  /// Derived trip type from the destination text; null when undetermined.
  category      MileageCategory?
  /// Calendar year of the trip, denormalized for cheap filtering/reporting.
  year          Int

  // Provenance — every field needed to trace this row to its spreadsheet.
  sourceFile    String
  sourceMd5     String
  sourceSheet   String?
  sourceRow     Int?
  /// The original row, keyed by its source header, for audit.
  rawRow        Json?
  /// Stable hash of the normalized trip; unique so re-imports and the three
  /// overlapping 2022 "Master" files collapse to one row.
  contentHash   String   @unique
  importSource  String   @default("document-archive")
  importBatchId String?
  importedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([year])
  @@index([driver])
  @@index([sourceMd5])
  @@map("mileage_entries")
}

enum MileageCategory {
  SHOW
  FARMERS_MARKET
  FUNDRAISER
  VENDOR
  ERRAND
  MISC
}

/// One row per file in the local (gitignored) `Documents/` business archive —
/// the searchable index over the ~3,100 PDFs/DOCX/scans and everything else that
/// cannot become typed domain rows. Metadata comes from the archive's own
/// `search_index.csv`; `extractedText` is full text we pull from the text-bearing
/// formats (scans have none until OCR). `sensitivity` gates HR/tax/bank records
/// so they are never exposed on public or customer-facing surfaces.
model ArchiveDocument {
  id             String                  @id @default(cuid())
  /// Path relative to the archive root, e.g. "03 Fundraisers/2024/...".
  path           String                  @unique
  /// Top-level archive folder, e.g. "01 Financial".
  category       String
  filename       String
  ext            String?
  sizeBytes      Int?
  md5            String?
  /// Where the file originally lived before the archive was organized.
  originalSource String?
  /// Year parsed from the path when the archive filed it by year; else null.
  year           Int?
  /// Short preview shipped in the archive's search_index.csv (often empty).
  textPreview    String?
  /// Full extracted text. Null for image-only scans until OCR is run.
  extractedText  String?
  textChars      Int                     @default(0)
  extraction     ArchiveExtractionStatus @default(PENDING)
  /// True when the file is a scan/image with no recoverable text layer.
  needsOcr       Boolean                 @default(false)
  sensitivity    ArchiveSensitivity      @default(INTERNAL)
  importSource   String                  @default("document-archive")
  importBatchId  String?
  importedAt     DateTime                @default(now())
  createdAt      DateTime                @default(now())

  @@index([category])
  @@index([year])
  @@index([sensitivity])
  @@index([extraction])
  @@map("archive_documents")
}

enum ArchiveExtractionStatus {
  PENDING
  EXTRACTED
  EMPTY
  SCANNED_NO_TEXT
  UNSUPPORTED
  ERROR
}

enum ArchiveSensitivity {
  PUBLIC
  INTERNAL
  SENSITIVE
}

/// One fundraiser campaign instance recovered from an order-form file in
/// `03 Fundraisers`. The archive holds two form shapes: an order-export sheet
/// (one row per customer order, with a "Total Jars" column) and the hand-filled
/// Jose Madrid order-form template (Organization/Submitted-by labels plus
/// per-flavor quantities). Both collapse to this per-file summary. Jar counts are
/// recoverable and trustworthy; dollar revenue usually is not, so it stays null
/// rather than being guessed from a price assumption.
model ArchivedFundraiser {
  id               String                     @id @default(cuid())
  organizationName String
  year             Int?
  orderDate        DateTime?
  submittedBy      String?
  contactEmail     String?
  contactPhone     String?
  formType         ArchivedFundraiserFormType @default(UNKNOWN)
  /// Total jars ordered: summed "Total Jars" (order-export) or summed per-flavor
  /// quantities (order-form template). Null when not recoverable.
  totalJars        Int?
  /// Number of underlying customer orders, for the order-export shape.
  orderCount       Int?
  /// Per-flavor quantity map for the order-form template shape.
  flavorsJson      Json?

  sourceFile    String   @unique
  sourceMd5     String?
  notes         String?
  importSource  String   @default("document-archive")
  importBatchId String?
  importedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([year])
  @@index([organizationName])
  @@map("archived_fundraisers")
}

enum ArchivedFundraiserFormType {
  ORDER_EXPORT
  ORDER_FORM
  UNKNOWN
}

/// A single show or farmers-market day's sales, recovered from the yearly sales
/// sheets in `04 Shows & Events` (e.g. "2025 Show Sales", "2025 Farmers Market").
/// One row per event day. Dollar sales here are the crew's own tallies, not QBO
/// — treat as historical record, not authoritative accounting.
model ArchivedShowSale {
  id            String           @id @default(cuid())
  showName      String
  showDate      DateTime?
  /// The raw date cell when it was a range like "1/3-5/2025" rather than a date.
  dateText      String?
  year          Int?
  eventType     ArchivedShowType @default(SHOW)
  sales         Decimal?         @db.Decimal(10, 2)
  amountPaid    Decimal?         @db.Decimal(10, 2)
  expenses      Decimal?         @db.Decimal(10, 2)
  salesPerson   String?
  sourceFile    String
  sourceMd5     String?
  sourceRow     Int?
  contentHash   String           @unique
  importSource  String           @default("document-archive")
  importBatchId String?
  importedAt    DateTime         @default(now())
  createdAt     DateTime         @default(now())

  @@index([year])
  @@index([eventType])
  @@map("archived_show_sales")
}

enum ArchivedShowType {
  SHOW
  FARMERS_MARKET
}

// ============================================================================
// Content Management System
// ============================================================================

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

/// SYSTEM pages map onto an existing hard-coded route and supply field
/// overrides plus section ordering/visibility. LANDING pages are composed
/// entirely in the admin from the block registry.
enum PageKind {
  SYSTEM
  LANDING
}

model Page {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  kind         PageKind      @default(LANDING)
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  scheduledFor DateTime?

  // Per-page SEO; falls back to the global SeoConfiguration templates when null
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  canonicalUrl   String?
  noIndex        Boolean @default(false)

  sections    PageSection[]
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([kind])
  @@map("cms_pages")
}

model PageSection {
  id                String           @id @default(cuid())
  pageId            String
  page              Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// Key into the block registry in lib/cms/blocks.ts
  type              String
  sortOrder         Int              @default(0)
  isVisible         Boolean          @default(true)
  data              Json             @default("{}")
  reusableSectionId String?
  reusableSection   ReusableSection? @relation(fields: [reusableSectionId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([pageId, sortOrder])
  @@index([reusableSectionId])
  @@map("cms_page_sections")
}

model ReusableSection {
  id        String        @id @default(cuid())
  key       String        @unique
  name      String
  type      String
  data      Json          @default("{}")
  status    ContentStatus @default(PUBLISHED)
  usages    PageSection[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("cms_reusable_sections")
}

enum BannerPlacement {
  SITE_WIDE_TOP
  HOMEPAGE_HERO
  CATEGORY
  CHECKOUT
  FUNDRAISING
}

model Banner {
  id          String          @id @default(cuid())
  name        String
  placement   BannerPlacement @default(SITE_WIDE_TOP)
  headline    String?
  body        String?
  imageUrl    String?
  imageAlt    String?
  ctaText     String?
  ctaHref     String?
  status      ContentStatus   @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  priority    Int             @default(0)
  /// Empty means every path; otherwise a list of path prefixes to match
  targetPaths String[]        @default([])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([placement, status, priority])
  @@map("cms_banners")
}

enum AnnouncementVariant {
  INFO
  PROMO
  WARNING
  SUCCESS
}

model Announcement {
  id          String              @id @default(cuid())
  message     String
  ctaText     String?
  ctaHref     String?
  variant     AnnouncementVariant @default(INFO)
  status      ContentStatus       @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  priority    Int                 @default(0)
  /// Empty means every path; otherwise a list of path prefixes to match
  targetPaths String[]            @default([])
  dismissible Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, priority])
  @@map("cms_announcements")
}

model FaqCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  items       FaqItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("cms_faq_categories")
}

model FaqItem {
  id         String        @id @default(cuid())
  question   String
  answer     String
  categoryId String?
  category   FaqCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sortOrder  Int           @default(0)
  status     ContentStatus @default(PUBLISHED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([categoryId, sortOrder])
  @@index([status])
  @@map("cms_faq_items")
}

enum NavigationLocation {
  HEADER
  FOOTER
  MOBILE
  UTILITY
}

model NavigationMenu {
  id        String             @id @default(cuid())
  location  NavigationLocation @unique
  name      String
  items     NavigationItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("cms_navigation_menus")
}

model NavigationItem {
  id           String           @id @default(cuid())
  menuId       String
  menu         NavigationMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       NavigationItem?  @relation("NavigationItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavigationItem[] @relation("NavigationItemChildren")
  label        String
  href         String
  description  String?
  iconName     String?
  sortOrder    Int              @default(0)
  isVisible    Boolean          @default(true)
  openInNewTab Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([menuId, parentId, sortOrder])
  @@map("cms_navigation_items")
}

/// Non-link footer content; the footer's link columns live in the
/// NavigationMenu whose location is FOOTER.
model FooterSettings {
  id                String   @id @default(cuid())
  tagline           String?
  aboutText         String?
  copyrightText     String?
  newsletterHeading String?
  newsletterBody    String?
  /// { facebook, instagram, tiktok, x, youtube, ... }
  socialLinks       Json?
  contactEmail      String?
  contactPhone      String?
  addressLines      String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("cms_footer_settings")
}

model Redirect {
  id          String    @id @default(cuid())
  source      String    @unique
  destination String
  permanent   Boolean   @default(true)
  isActive    Boolean   @default(true)
  hitCount    Int       @default(0)
  lastHitAt   DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@map("cms_redirects")
}
