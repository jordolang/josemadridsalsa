model FeaturedEvent {
  id                      String             @id @default(cuid())
  googleEventId           String?            @unique
  title                   String
  description             String?
  location                String?
  startDate               DateTime
  endDate                 DateTime?
  featuredFrom            DateTime
  featuredTo              DateTime?
  isWhereIsJose           Boolean            @default(false)
  customDescription       String?
  manuallyModified        Boolean            @default(false)
  modifiedFields          Json?
  lastGoogleSync          DateTime?
  displayPriority         Int                @default(0)
  connectedByUserId       String?
  /// Date our application/registration for the show is due. Distinct from
  /// startDate: deadlines routinely fall months before the event itself.
  applicationDeadline     DateTime?
  /// Where we are in the booking pipeline for this show.
  bookingStatus           EventBookingStatus @default(CONFIRMED)
  /// Booth/vendor fee in USD.
  boothFee                Decimal?           @db.Decimal(10, 2)
  /// Fields below come from the strict 20-column Show import CSV. All are
  /// nullable: an empty cell there means "not published", never zero.
  venue                   String?
  address                 String?
  city                    String?
  state                   String?            @db.VarChar(2)
  /// Driving time from the shop, as exported, e.g. "7h 04m".
  driveTime               String?
  /// Operating hours as free text, e.g. "Sat 10am-6pm; Sun 11am-5pm".
  eventTimes              String?
  /// The Application Deadline cell verbatim. Often prose ("until full") rather
  /// than a date, so `applicationDeadline` above stays null while this survives.
  applicationDeadlineText String?
  /// A trailing `*` in the export means estimated, not published by the promoter.
  boothFeeEstimated       Boolean            @default(false)
  /// Parenthetical after the fee, e.g. "$750.00* (Contact)" -> "Contact".
  boothFeeNote            String?
  attendance              Int?
  attendanceEstimated     Boolean            @default(false)
  exhibitors              Int?
  exhibitorsEstimated     Boolean            @default(false)
  /// Estimated trip costs in USD.
  costOfFuel              Decimal?           @db.Decimal(10, 2)
  lodging                 Decimal?           @db.Decimal(10, 2)
  meals                   Decimal?           @db.Decimal(10, 2)
  /// How to apply, as written by the promoter.
  applicationInfo         String?
  /// Where this event record came from (manual entry, Google Calendar, a
  /// FestivalNet CSV import).
  source                  EventSource        @default(MANUAL)
  /// Identifier from `source`, used to make re-imports idempotent. FestivalNet
  /// re-exports the entire list every time, so imports must match on this. For
  /// the Show import CSV this holds the FestivalNet posting URL — the natural
  /// key. Never match on event name: names repeat across years and across
  /// monthly variants of one series.
  externalId              String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  eventTags               EventTag[]
  staff                   EventStaff[]
  contacts                EventContact[]
  manifest                EventManifest?

  @@unique([source, externalId])
  @@index([isWhereIsJose])
  @@index([featuredFrom, featuredTo])
  @@index([applicationDeadline])
  @@index([bookingStatus, startDate])
  @@map("featured_events")
}

/// Pipeline state for a show we are trying to book. Existing rows default to
/// CONFIRMED because everything already in the table is a show we are working.
