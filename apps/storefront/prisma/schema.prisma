}

/// Product manifest for an event: what we pack out and what returns.
model EventManifest {
  id         String              @id @default(cuid())
  eventId    String              @unique
  status     EventManifestStatus @default(DRAFT)
  packedAt   DateTime?
  returnedAt DateTime?
  notes      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  event      FeaturedEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items      EventManifestItem[]

  @@map("event_manifests")
}

/// One product line on an event manifest. Quantities are tracked as cases + loose
/// jars for both what is taken and what returns; units sold is derived from the two.
model EventManifestItem {
  id             String        @id @default(cuid())
  manifestId     String
  productId      String
  expirationDate DateTime?
  takenCases     Int           @default(0)
  takenJars      Int           @default(0)
  returnedCases  Int           @default(0)
  returnedJars   Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  manifest       EventManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([manifestId, productId])
  @@index([manifestId])
  @@map("event_manifest_items")
}

model EventTag {
