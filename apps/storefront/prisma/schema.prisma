model FeaturedEvent {
  id                String     @id @default(cuid())
  googleEventId     String?    @unique
  title             String
  description       String?
  location          String?
  startDate         DateTime
  endDate           DateTime?
  featuredFrom      DateTime
  featuredTo        DateTime?
  isWhereIsJose     Boolean    @default(false)
  customDescription String?
  manuallyModified  Boolean    @default(false)
  modifiedFields    Json?
  lastGoogleSync    DateTime?
  displayPriority   Int        @default(0)
  connectedByUserId String?
  /// Date our application/registration for the show is due. Distinct from
  /// startDate: deadlines routinely fall months before the event itself.
  applicationDeadline DateTime?
  /// Where we are in the booking pipeline for this show.
  bookingStatus     EventBookingStatus @default(CONFIRMED)
  /// Booth/vendor fee in USD.
  boothFee          Decimal?   @db.Decimal(10, 2)
  /// Where this event record came from (manual entry, Google Calendar, a
  /// FestivalNet CSV import).
  source            EventSource @default(MANUAL)
  /// Identifier from `source`, used to make re-imports idempotent. FestivalNet
  /// re-exports the entire list every time, so imports must match on this.
  externalId        String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  eventTags         EventTag[]
  staff             EventStaff[]
  contacts          EventContact[]
  manifest          EventManifest?

  @@unique([source, externalId])
  @@index([isWhereIsJose])
  @@index([featuredFrom, featuredTo])
  @@index([applicationDeadline])
  @@index([bookingStatus, startDate])
  @@map("featured_events")
}

/// Pipeline state for a show we are trying to book. Existing rows default to
/// CONFIRMED because everything already in the table is a show we are working.
enum EventBookingStatus {
  INTERESTED
  APPLIED
  WAITLISTED
  ACCEPTED
  CONFIRMED
  DECLINED
  CANCELLED
}

enum EventSource {
  MANUAL
  GOOGLE_CALENDAR
  FESTIVALNET
}

/// People from our team assigned to attend/work an event.
model EventStaff {
  id               String        @id @default(cuid())
  eventId          String
  name             String
  role             String?
  phone            String?
  email            String?
  isPrimaryContact Boolean       @default(false)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  event            FeaturedEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_staff")
}

/// Point-of-contact personnel on file for an event (organizer, venue, coordinator).
model EventContact {
  id           String        @id @default(cuid())
  eventId      String
  name         String
  organization String?
  role         String?
  phone        String?
  email        String?
  notes        String?
