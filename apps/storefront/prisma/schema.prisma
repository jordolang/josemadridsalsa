generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                      String                        @id @default(cuid())
  email                   String                        @unique
  name                    String?
  password                String?
  /// TOTP shared secret, encrypted at rest with the credential vault key (lib/crypto.ts).
  /// Never returned to the client once enrolment completes.
  twoFactorSecret         String?
  twoFactorSecretIv       String?
  /// Non-null once the user has proved they can generate a valid code. A secret without
  /// this is a half-finished enrolment and must not gate sign-in.
  twoFactorEnabledAt      DateTime?
  twoFactorRecoveryCodes  TwoFactorRecoveryCode[]
  role                    UserRole                      @default(CUSTOMER)
  isEmailVerified         Boolean                       @default(false)
  phone                   String?
  dateOfBirth             DateTime?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  lastLoginAt             DateTime?
  stripeCustomerId        String?                       @unique
  abandonedCarts          AbandonedCart[]
  addresses               Address[]
  analyticsSettings       AnalyticsSetting[]
  cartItems               CartItem[]
  conversations           Conversation[]
  discountCodes           DiscountCode[]
  discountUsages          DiscountUsage[]
  emailLogs               EmailLog[]
  fundraiserAccount       FundraiserAccount?
  claimedCharacters       FundraiserCharacter[]         @relation("CharacterClaimant")
  fundraiserMessages      FundraiserMessage[]
  fundraiserSaleReactions FundraiserSaleEventReaction[]
  fundraiserSaleReplies   FundraiserSaleEventReply[]
  fundraiserSaleEvents    FundraiserSaleEvent[]
  loyaltyAccount          LoyaltyAccount?
  orders                  Order[]
  partnerApiKeys          PartnerApiKey[]
  passwordResetTokens     PasswordResetToken[]
  purchaseOrders          PurchaseOrder[]
  purchaseOrderReceipts   PurchaseOrderReceipt[]
  reviews                 Review[]
  shippingSettings        ShippingSettings[]
  unsubscribePreferences  UnsubscribePreference[]
  wholesaleAccount        WholesaleAccount?
  wishlistItems           WishlistItem[]
  blogPosts               BlogPost[]                    @relation("BlogAuthor")
  blogComments            BlogComment[]                 @relation("BlogCommenter")
  blogReactions           BlogReaction[]                @relation("BlogReactor")
  customer                Customer?
  timeClockEntries        TimeClockEntry[]

  @@map("users")
}

/// An append-only staff timeclock punch pair. One row per clock-in/clock-out,
/// so a lunch break simply creates a second row on the same day. Hours are
/// always derived from the timestamps — never stored — and rows are never
/// updated after clock-out, which is what keeps the record tamper-evident.
/// A partial unique index (see the migration) allows at most one open row
/// (clockOutAt IS NULL) per user.
///
/// Caveat: `onDelete: Cascade` matches the rest of this schema, which means
/// deleting a User through /api/admin/users/[id] destroys their punch history
/// too. Switch to Restrict if payroll records must outlive the account.
model TimeClockEntry {
  id         String    @id @default(cuid())
  userId     String
  clockInAt  DateTime  @default(now())
  clockOutAt DateTime?
  clockInIp  String?
  clockOutIp String?
  notes      String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clockInAt])
  @@map("time_clock_entries")
}

/// A unified customer/contact record. Distinct from `User` (login accounts):
/// this table also holds email-only contacts imported from mailing lists and
/// people who only ever checked out as guests. Registered users are linked via
/// `userId`. Populated by CSV import and by the /api/admin/customers/sync job.
model Customer {
  id                    String              @id @default(cuid())
  email                 String              @unique
  firstName             String?
  lastName              String?
  phone                 String?
  source                CustomerSource      @default(MANUAL)
  accountType           CustomerAccountType @default(STANDARD)
  sourceName            String?
  emailStatus           String?
  emailPermissionStatus String?
  notes                 String?
  userId                String?             @unique
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  totalOrders           Int                 @default(0)
  totalSpent            Decimal             @default(0) @db.Decimal(10, 2)
  lastOrderAt           DateTime?
  importSource          String?
  importBatchId         String?
  importedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([source])
  @@index([accountType])
  @@map("customers")
}

model Address {
  id             String      @id @default(cuid())
  userId         String?
  type           AddressType @default(SHIPPING)
  firstName      String
  lastName       String
  company        String?
  street         String
  city           String
  state          String
  zipCode        String
  country        String      @default("US")
  phone          String?
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingOrders  Order[]     @relation("BillingAddress")
  shippingOrders Order[]     @relation("ShippingAddress")

  @@index([userId])
  @@map("addresses")
}

model Category {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  description     String?
  image           String?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]

  @@map("categories")
}

model Product {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  description            String?
  heatLevel              HeatLevel
  ingredients            String[]
  price                  Decimal                 @db.Decimal(10, 2)
  compareAtPrice         Decimal?                @db.Decimal(10, 2)
  costPrice              Decimal?                @db.Decimal(10, 2)
  taxCode                String?
  sku                    String                  @unique
  barcode                String?
  inventory              Int                     @default(0)
  lowStockThreshold      Int                     @default(5)
  images                 String[]
  featuredImage          String?
  weight                 Decimal?                @db.Decimal(8, 2)
  lengthInches           Decimal?                @db.Decimal(8, 2)
  widthInches            Decimal?                @db.Decimal(8, 2)
  heightInches           Decimal?                @db.Decimal(8, 2)
  dimensions             Json?
  metaTitle              String?
  metaDescription        String?
  ogImage                String?
  searchKeywords         String[]
  isActive               Boolean                 @default(true)
  isFeatured             Boolean                 @default(false)
  sortOrder              Int                     @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  categoryId             String
  stockReserved          Int                     @default(0)
  stockStatus            StockStatus             @default(IN_STOCK)
  unitsPerCase           Int                     @default(12)
  cartItems              CartItem[]
  eventManifestItems     EventManifestItem[]
  fundraiserProducts     FundraiserProduct[]
  fundraiserTeamProducts FundraiserTeamProduct[]
  inventoryAlerts        InventoryAlert[]
  inventoryTransactions  InventoryTransaction[]
  nutritionalInfo        NutritionalInfo?
  orderItems             OrderItem[]
  productIngredients     ProductIngredient[]
  productTags            ProductTag[]
  purchaseOrderItems     PurchaseOrderItem[]
  variants               ProductVariant[]
  category               Category                @relation(fields: [categoryId], references: [id])
  restockNotifications   RestockNotification[]
  reviews                Review[]
  shopListings           ShopListing[]
  wishlistItems          WishlistItem[]

  @@index([stockStatus])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  type      String
  price     Decimal? @db.Decimal(10, 2)
  sku       String?  @unique
  inStock   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model NutritionalInfo {
  id                   String   @id @default(cuid())
  productId            String   @unique
  servingSize          String
  servingsPerContainer Int      @default(13)
  calories             Int      @default(0)
  caloriesFromFat      Int      @default(0)
  totalFatG            Float    @default(0)
  totalFatDV           Int      @default(0)
  saturatedFatG        Float    @default(0)
  saturatedFatDV       Int      @default(0)
  transFatG            Float    @default(0)
  cholesterolMg        Float    @default(0)
  cholesterolDV        Int      @default(0)
  sodiumMg             Float    @default(0)
  sodiumDV             Int      @default(0)
  totalCarbG           Float    @default(0)
  totalCarbDV          Int      @default(0)
  dietaryFiberG        Float    @default(0)
  dietaryFiberDV       Int      @default(0)
  sugarsG              Float    @default(0)
  proteinG             Float    @default(0)
  vitaminADV           Int      @default(0)
  vitaminCDV           Int      @default(0)
  calciumDV            Int      @default(0)
  ironDV               Int      @default(0)
  allergens            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("nutritional_info")
}

model Ingredient {
  id        String              @id @default(cuid())
  name      String              @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  products  ProductIngredient[]

  @@map("ingredients")
}

model ProductIngredient {
  id           String     @id @default(cuid())
  productId    String
  ingredientId String
  sortOrder    Int        @default(0)
  qualifier    String?
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([productId])
  @@map("product_ingredients")
}

model ShopListing {
  id                  String            @id @default(cuid())
  productId           String
  shopPlatform        ShopPlatform
  externalId          String?
  externalUrl         String?
  catalogId           String?
  status              ShopListingStatus @default(PENDING)
  syncError           String?
  titleOverride       String?
  descriptionOverride String?
  priceOverride       Decimal?          @db.Decimal(10, 2)
  condition           String?           @default("new")
  availability        String?           @default("in stock")
  marketplaceCategory String?
  lastSyncedAt        DateTime?
  publishedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  socialAccountId     String?
  product             Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  socialAccount       SocialAccount?    @relation(fields: [socialAccountId], references: [id])

  @@unique([productId, shopPlatform])
  @@index([shopPlatform, status])
  @@index([productId])
  @@index([socialAccountId])
  @@map("shop_listings")
}

model Conversation {
  id        String             @id @default(cuid())
  subject   String?
  userId    String?
  email     String?
  status    ConversationStatus @default(OPEN)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User?              @relation(fields: [userId], references: [id])
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderType     MessageSenderType
  body           String
  readAt         DateTime?
  createdAt      DateTime          @default(now())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model AbandonedCart {
  id            String    @id @default(cuid())
  userId        String?
  guestEmail    String?
  cartData      Json
  recoveryToken String    @unique @default(cuid())
  recoveredAt   DateTime?
  emailStage    Int       @default(0)
  emailSent     Boolean   @default(false)
  emailSentAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([userId])
  @@index([guestEmail])
  @@index([emailSent, emailStage, createdAt])
  @@map("abandoned_carts")
}

model DiscountCode {
  id             String          @id @default(cuid())
  code           String          @unique
  description    String?
  type           DiscountType
  value          Decimal         @db.Decimal(10, 2)
  maxUses        Int?
  usedCount      Int             @default(0)
  maxUsesPerUser Int?
  minPurchase    Decimal?        @db.Decimal(10, 2)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String?
  createdBy      User?           @relation(fields: [createdById], references: [id])
  usages         DiscountUsage[]

  @@index([code])
  @@index([isActive, expiresAt])
  @@map("discount_codes")
}

model DiscountUsage {
  id             String       @id @default(cuid())
  discountCodeId String
  orderId        String
  userId         String?
  discountAmount Decimal      @db.Decimal(10, 2)
  orderTotal     Decimal      @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([discountCodeId])
  @@index([userId])
  @@index([orderId])
  @@map("discount_usages")
}

model LoyaltyAccount {
  id             String             @id @default(cuid())
  userId         String             @unique
  pointsBalance  Int                @default(0)
  lifetimePoints Int                @default(0)
  tier           LoyaltyTier        @default(BRONZE)
  tierUpdatedAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   PointTransaction[]
  rewards        RewardRedemption[]

  @@map("loyalty_accounts")
}

model PointTransaction {
  id          String               @id @default(cuid())
  accountId   String
  type        PointTransactionType
  points      Int
  description String
  orderId     String?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  account     LoyaltyAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("point_transactions")
}

model LoyaltyReward {
  id             String             @id @default(cuid())
  name           String
  description    String
  pointsCost     Int
  rewardType     String
  rewardValue    Decimal?           @db.Decimal(10, 2)
  isActive       Boolean            @default(true)
  minimumTier    LoyaltyTier        @default(BRONZE)
  maxRedemptions Int?
  usedCount      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  redemptions    RewardRedemption[]

  @@map("loyalty_rewards")
}

model RewardRedemption {
  id           String         @id @default(cuid())
  accountId    String
  rewardId     String
  pointsSpent  Int
  status       String
  discountCode String?
  expiresAt    DateTime?
  usedAt       DateTime?
  createdAt    DateTime       @default(now())
  account      LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reward       LoyaltyReward  @relation(fields: [rewardId], references: [id])

  @@index([accountId])
  @@index([status])
  @@index([expiresAt])
  @@map("reward_redemptions")
}

model Order {
  id                       String                 @id @default(cuid())
  orderNumber              String                 @unique
  userId                   String?
  guestEmail               String?
  guestPhone               String?
  shippingAddressId        String?
  billingAddressId         String?
  status                   OrderStatus            @default(PENDING)
  /// Fulfillment is tracked separately from `status` and `paymentStatus` so an order can be
  /// (for example) PAID + PARTIALLY_FULFILLED without either field lying. Always write this
  /// through `lib/orders/fulfillment.ts` so it cannot drift from `status`.
  fulfillmentStatus        FulfillmentStatus      @default(UNFULFILLED)
  /// Where the order originated. Derived from paymentChannel/fundraiserId/shopifyOrderId/
  /// importSource at creation time — see `lib/orders/sales-channel.ts` for the precedence.
  salesChannel             SalesChannel           @default(WEBSITE)
  subtotal                 Decimal                @db.Decimal(10, 2)
  shippingCost             Decimal                @default(0) @db.Decimal(10, 2)
  tax                      Decimal                @default(0) @db.Decimal(10, 2)
  discountAmount           Decimal                @default(0) @db.Decimal(10, 2)
  // Codes applied at checkout. Recorded on the order so that completion (which may run
  // in the Stripe webhook, with no request context) knows what to redeem. Redemption is
  // deferred to payment success so an abandoned checkout cannot burn a gift balance or
  // consume a discount's usage allowance.
  discountCode             String?
  giftCertificateCode      String?
  giftCertificateAmount    Decimal                @default(0) @db.Decimal(10, 2)
  total                    Decimal                @db.Decimal(10, 2)
  shippingMethod           String?
  trackingNumber           String?
  estimatedDelivery        DateTime?
  actualDelivery           DateTime?
  shippingLabelUrl         String?
  easypostShipmentId       String?
  carrierName              String?
  trackingUrl              String?
  lastTrackingUpdate       DateTime?
  trackingHistory          Json?
  packingSlipUrl           String?
  invoiceUrl               String?
  invoiceSentAt            DateTime?
  modificationHistory      Json?
  paymentStatus            PaymentStatus          @default(PENDING)
  paymentMethod            String?
  stripePaymentId          String?
  customerNotes            String?
  adminNotes               String?
  shopifyOrderId           String?                @unique
  shopifyOrderName         String?
  shopifyFinancialStatus   String?
  shopifyFulfillmentStatus String?
  shopifySyncedAt          DateTime?
  shopifySyncError         String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  shippedAt                DateTime?
  deliveredAt              DateTime?
  confirmationEmailSentAt  DateTime?
  reviewRequestSentAt      DateTime?
  /// When the customer was told their refund went through. Null means not yet told.
  ///
  /// Two things send this email — the admin status change, and the consumer that reacts to a
  /// refund actually settling at the processor — and they are reached by different admin
  /// actions on the same order. Without a shared marker a customer can be emailed twice about
  /// the same money, which reads as two refunds.
  refundEmailSentAt        DateTime?
  /// Set once, by whichever path marks the order paid first. The claim on this column is what
  /// stops the same sale being credited twice when a webhook and a completion route race.
  commissionCreditedAt     DateTime?
  /// What the group was actually paid for this order, recorded at the moment it was credited.
  /// Null means not a fundraiser order, or not yet credited — never zero. The rate is editable
  /// afterwards, so recomputing this later would disagree with what was really handed over.
  fundraiserCommission     Decimal?               @db.Decimal(10, 2)
  fundraiserId             String?
  importSource             String?
  importBatchId            String?
  importedAt               DateTime?
  printedInvoiceAt         DateTime?
  printedPackingSlipAt     DateTime?
  participantId            String?
  paymentChannel           PaymentChannel?        @default(ONLINE)
  paymentProvider          PaymentProvider?       @default(STRIPE)
  providerPaymentId        String?
  abandonedCartId          String?
  supportMessages          FundraiserMessage[]
  giftCertificateUsages    GiftCertificateUsage[]
  giftCertificates         GiftCertificate[]
  items                    OrderItem[]
  billingAddress           Address?               @relation("BillingAddress", fields: [billingAddressId], references: [id])
  fundraiser               Fundraiser?            @relation(fields: [fundraiserId], references: [id])
  participant              FundraiserParticipant? @relation(fields: [participantId], references: [id])
  shippingAddress          Address?               @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  user                     User?                  @relation(fields: [userId], references: [id])
  abandonedCart            AbandonedCart?         @relation(fields: [abandonedCartId], references: [id])
  payments                 Payment[]
  shippingLabels           ShippingLabel[]
  fulfillments             Fulfillment[]
  returnRequests           ReturnRequest[]

  /// Set when this order is a replacement raised by an exchange rather than a sale.
  ///
  /// **Non-null means "not a sale".** A replacement is a fulfillment obligation the customer
  /// has already paid for on the original order, so its total is zero while its items still
  /// carry a real `unitCost`. Left in the sales population it would report as revenue 0 against
  /// cost > 0 — a loss on every exchange, blended into product and channel margin. Every
  /// revenue report therefore filters `exchangeForReturnId: null`.
  exchangeForReturnId      String?                @unique
  exchangeForReturn        ReturnRequest?         @relation("ExchangeForReturn", fields: [exchangeForReturnId], references: [id])

  @@index([userId])
  @@index([participantId])
  @@index([abandonedCartId])
  @@index([fulfillmentStatus])
  @@index([salesChannel])
  @@map("orders")
}

/// A single shipment (or pickup handoff) covering some subset of an order's items.
/// An order with one Fulfillment covering everything is the common case; multiple
/// rows model split shipments.
model Fulfillment {
  id              String            @id @default(cuid())
  orderId         String
  status          FulfillmentStatus @default(FULFILLED)
  trackingNumber  String?
  carrierName     String?
  trackingUrl     String?
  shippingLabelId String?
  notes           String?
  createdById     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items           FulfillmentItem[]

  @@index([orderId])
  @@index([status])
  @@map("fulfillments")
}

model FulfillmentItem {
  id            String      @id @default(cuid())
  fulfillmentId String
  orderItemId   String
  quantity      Int
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([fulfillmentId, orderItemId])
  @@index([orderItemId])
  @@map("fulfillment_items")
}

/// A customer's request to send goods back. Only quantities that actually shipped can be
/// returned, so this hangs off the fulfillment accounting rather than the raw order lines.
model ReturnRequest {
  id            String              @id @default(cuid())
  rmaNumber     String              @unique
  orderId       String
  status        ReturnStatus        @default(REQUESTED)
  reason        ReturnReason
  resolution    ReturnResolution    @default(REFUND)
  customerNote  String?
  adminNote     String?
  /// Withheld from the refund. Stored per-request because it is a judgement call.
  restockingFee Decimal?            @db.Decimal(10, 2)
  /// The refund this return produced, set when it is completed with a REFUND resolution.
  refundId      String?             @unique
  /// Store credit issued instead of a refund, set when completed with STORE_CREDIT. Exactly
  /// one of `refundId` / `giftCertificateId` / `exchangeOrder` is ever populated — see
  /// `lib/orders/return-resolution.ts`.
  giftCertificateId String?         @unique
  requestedById String?
  approvedById  String?
  approvedAt    DateTime?
  receivedAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  /// Prepaid label emailed to the customer so they can send the goods back.
  ///
  /// Stored here rather than as a `ShippingLabel` row on purpose. `lib/tracking/webhook-handlers.ts`
  /// looks a label up by `trackingCode` and advances **that label's order** to shipped and then
  /// delivered — so a return label would mark the customer's order DELIVERED the moment the
  /// parcel reached the warehouse. Keeping return labels out of that table makes the collision
  /// impossible rather than guarded. The cost is that return shipments are not tracked.
  returnLabelShipmentId  String?    @unique
  returnLabelTrackingCode String?
  returnLabelUrl         String?
  returnLabelCarrier     String?
  returnLabelService     String?
  /// In cents, matching Payment.processorFee. Null means no label bought, never free.
  returnLabelCostCents   Int?
  returnLabelPurchasedAt DateTime?

  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refund        Refund?             @relation(fields: [refundId], references: [id])
  giftCertificate GiftCertificate?  @relation(fields: [giftCertificateId], references: [id])
  /// The replacement order raised for an EXCHANGE resolution. The foreign key lives on `Order`
  /// so revenue reports can exclude exchanges with a single `where` on the order itself.
  exchangeOrder Order?              @relation("ExchangeForReturn")
  items         ReturnRequestItem[]

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("return_requests")
}

model ReturnRequestItem {
  id              String               @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  /// Recorded at inspection; decides whether the units go back on the shelf.
  condition       ReturnItemCondition?
  /// Whether stock has been put back for this line, so a re-run cannot double-restock.
  restocked       Boolean              @default(false)
  returnRequest   ReturnRequest        @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem            @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@map("return_request_items")
}

/// Append-only log of business facts (`order.created`, `payment.completed`, …).
/// Consumers subscribe to these rather than being hand-wired at each call site;
/// it also backs per-entity activity timelines. Write via `lib/domain-events/emit.ts`.
model DomainEvent {
  id          String    @id @default(cuid())
  type        String
  entityType  String
  entityId    String
  payload     Json?
  actorUserId String?
  createdAt   DateTime  @default(now())
  /// When consumers finished handling this event. Null means still pending.
  ///
  /// This column is what makes `domain_events` a transactional outbox rather than only an
  /// audit log. Events are emitted inside the caller's transaction (payment webhooks pass
  /// their `tx` client), so handlers cannot run at emit time — they would fire for work that
  /// may still roll back, and would hold a transaction open across network I/O. A poller
  /// only ever sees committed rows, which makes the hand-off correct by construction.
  consumedAt  DateTime?

  @@index([entityType, entityId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([consumedAt, createdAt])
  @@map("domain_events")
}

model OrderItem {
  id                String              @id @default(cuid())
  orderId           String
  productId         String
  quantity          Int
  /// How many of `quantity` have shipped. Never exceeds `quantity`; the sum of this
  /// column across an order is what derives `Order.fulfillmentStatus`.
  quantityFulfilled Int                 @default(0)
  unitPrice         Decimal             @db.Decimal(10, 2)
  /// What this unit cost us at the moment of sale, snapshotted from `Product.costPrice`.
  /// Margin has to be computed from this rather than the product's current cost, or last
  /// year's margin gets recalculated with this year's prices every time a cost changes.
  /// Null means the cost was unknown when the order was placed — never treat it as zero.
  unitCost          Decimal?            @db.Decimal(10, 2)
  totalPrice        Decimal             @db.Decimal(10, 2)
  productName       String
  productSku        String
  productImage      String?
  createdAt         DateTime            @default(now())
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id])
  fulfillmentItems  FulfillmentItem[]
  returnItems       ReturnRequestItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                       String           @id @default(cuid())
  stripePaymentIntentId    String?          @unique
  stripeCheckoutSessionId  String?          @unique
  amount                   Int
  /// What the processor charged us to take this payment, in cents.
  ///
  /// Null means not yet known, which is the normal state immediately after a payment:
  /// Square only computes its fee after settlement, and Stripe's requires expanding the
  /// balance transaction. A reconciliation sweep fills it in. Null must never be read as
  /// zero — that would report a fee-free payment and overstate profit.
  processorFee             Int?
  /// When the fee above was last looked up, so the sweep knows what it has already tried.
  processorFeeCheckedAt    DateTime?
  currency                 String           @default("usd")
  status                   PaymentStatus    @default(PENDING)
  paymentMethod            String?
  orderId                  String
  metadata                 Json?
  stripeCustomerId         String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  paidAt                   DateTime?
  channel                  PaymentChannel?  @default(ONLINE)
  methodType               String?
  paypalCaptureId          String?          @unique
  paypalOrderId            String?          @unique
  provider                 PaymentProvider? @default(STRIPE)
  providerPaymentId        String?
  squarePaymentId          String?          @unique
  squareTerminalCheckoutId String?          @unique
  order                    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds                  Refund[]

  @@index([orderId])
  @@index([status])
  @@index([provider])
  @@map("payments")
}

model Refund {
  id             String          @id @default(cuid())
  /// The processor's refund ID. Despite the name this is provider-agnostic — PayPal and
  /// Square refunds store their own IDs here. Pair it with `provider` to identify the
  /// processor; the column is not renamed because doing so would drop existing IDs.
  stripeRefundId String          @unique
  provider       PaymentProvider @default(STRIPE)
  amount         Int
  reason         String?
  status         RefundStatus    @default(PENDING)
  paymentId      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  processedAt    DateTime?
  /// Fundraiser commission taken back because of this refund. Non-null is also the claim that
  /// stops the same refund reversing twice. Null means not a fundraiser refund, or not yet
  /// processed — never zero.
  commissionReversed Decimal?    @db.Decimal(10, 2)
  payment        Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  returnRequest  ReturnRequest?

  @@index([paymentId])
  @@index([provider])
  @@map("refunds")
}

