generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                      String                        @id @default(cuid())
  email                   String                        @unique
  name                    String?
  password                String?
  role                    UserRole                      @default(CUSTOMER)
  isEmailVerified         Boolean                       @default(false)
  phone                   String?
  dateOfBirth             DateTime?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  lastLoginAt             DateTime?
  stripeCustomerId        String?                       @unique
  abandonedCarts          AbandonedCart[]
  addresses               Address[]
  analyticsSettings       AnalyticsSetting[]
  cartItems               CartItem[]
  conversations           Conversation[]
  discountCodes           DiscountCode[]
  discountUsages          DiscountUsage[]
  emailLogs               EmailLog[]
  fundraiserAccount       FundraiserAccount?
  claimedCharacters       FundraiserCharacter[]         @relation("CharacterClaimant")
  fundraiserMessages      FundraiserMessage[]
  fundraiserSaleReactions FundraiserSaleEventReaction[]
  fundraiserSaleReplies   FundraiserSaleEventReply[]
  fundraiserSaleEvents    FundraiserSaleEvent[]
  loyaltyAccount          LoyaltyAccount?
  orders                  Order[]
  partnerApiKeys          PartnerApiKey[]
  passwordResetTokens     PasswordResetToken[]
  reviews                 Review[]
  shippingSettings        ShippingSettings[]
  unsubscribePreferences  UnsubscribePreference[]
  wholesaleAccount        WholesaleAccount?
  wishlistItems           WishlistItem[]
  blogPosts               BlogPost[]                    @relation("BlogAuthor")
  blogComments            BlogComment[]                 @relation("BlogCommenter")
  blogReactions           BlogReaction[]                @relation("BlogReactor")

  @@map("users")
}

model Address {
  id             String      @id @default(cuid())
  userId         String?
  type           AddressType @default(SHIPPING)
  firstName      String
  lastName       String
  company        String?
  street         String
  city           String
  state          String
  zipCode        String
  country        String      @default("US")
  phone          String?
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingOrders  Order[]     @relation("BillingAddress")
  shippingOrders Order[]     @relation("ShippingAddress")

  @@index([userId])
  @@map("addresses")
}

model Category {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  description     String?
  image           String?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]

  @@map("categories")
}

model Product {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  description            String?
  heatLevel              HeatLevel
  ingredients            String[]
  price                  Decimal                 @db.Decimal(10, 2)
  compareAtPrice         Decimal?                @db.Decimal(10, 2)
  costPrice              Decimal?                @db.Decimal(10, 2)
  taxCode                String?
  sku                    String                  @unique
  barcode                String?
  inventory              Int                     @default(0)
  lowStockThreshold      Int                     @default(5)
  images                 String[]
  featuredImage          String?
  weight                 Decimal?                @db.Decimal(8, 2)
  lengthInches           Decimal?                @db.Decimal(8, 2)
  widthInches            Decimal?                @db.Decimal(8, 2)
  heightInches           Decimal?                @db.Decimal(8, 2)
  dimensions             Json?
  metaTitle              String?
  metaDescription        String?
  ogImage                String?
  searchKeywords         String[]
  isActive               Boolean                 @default(true)
  isFeatured             Boolean                 @default(false)
  sortOrder              Int                     @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  categoryId             String
  stockReserved          Int                     @default(0)
  stockStatus            StockStatus             @default(IN_STOCK)
  unitsPerCase           Int                     @default(12)
  cartItems              CartItem[]
  eventManifestItems     EventManifestItem[]
  fundraiserProducts     FundraiserProduct[]
  fundraiserTeamProducts FundraiserTeamProduct[]
  inventoryAlerts        InventoryAlert[]
  inventoryTransactions  InventoryTransaction[]
  nutritionalInfo        NutritionalInfo?
  orderItems             OrderItem[]
  productIngredients     ProductIngredient[]
  productTags            ProductTag[]
  variants               ProductVariant[]
  category               Category                @relation(fields: [categoryId], references: [id])
  restockNotifications   RestockNotification[]
  reviews                Review[]
  shopListings           ShopListing[]
  wishlistItems          WishlistItem[]

  @@index([stockStatus])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  type      String
  price     Decimal? @db.Decimal(10, 2)
  sku       String?  @unique
  inStock   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model NutritionalInfo {
  id                   String   @id @default(cuid())
  productId            String   @unique
  servingSize          String
  servingsPerContainer Int      @default(13)
  calories             Int      @default(0)
  caloriesFromFat      Int      @default(0)
  totalFatG            Float    @default(0)
  totalFatDV           Int      @default(0)
  saturatedFatG        Float    @default(0)
  saturatedFatDV       Int      @default(0)
  transFatG            Float    @default(0)
  cholesterolMg        Float    @default(0)
  cholesterolDV        Int      @default(0)
  sodiumMg             Float    @default(0)
  sodiumDV             Int      @default(0)
  totalCarbG           Float    @default(0)
  totalCarbDV          Int      @default(0)
  dietaryFiberG        Float    @default(0)
  dietaryFiberDV       Int      @default(0)
  sugarsG              Float    @default(0)
  proteinG             Float    @default(0)
  vitaminADV           Int      @default(0)
  vitaminCDV           Int      @default(0)
  calciumDV            Int      @default(0)
  ironDV               Int      @default(0)
  allergens            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("nutritional_info")
}

model Ingredient {
  id        String              @id @default(cuid())
  name      String              @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  products  ProductIngredient[]

  @@map("ingredients")
}

model ProductIngredient {
  id           String     @id @default(cuid())
  productId    String
  ingredientId String
  sortOrder    Int        @default(0)
  qualifier    String?
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([productId])
  @@map("product_ingredients")
}

model ShopListing {
  id                  String            @id @default(cuid())
  productId           String
  shopPlatform        ShopPlatform
  externalId          String?
  externalUrl         String?
  catalogId           String?
  status              ShopListingStatus @default(PENDING)
  syncError           String?
  titleOverride       String?
  descriptionOverride String?
  priceOverride       Decimal?          @db.Decimal(10, 2)
  condition           String?           @default("new")
  availability        String?           @default("in stock")
  marketplaceCategory String?
  lastSyncedAt        DateTime?
  publishedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  socialAccountId     String?
  product             Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  socialAccount       SocialAccount?    @relation(fields: [socialAccountId], references: [id])

  @@unique([productId, shopPlatform])
  @@index([shopPlatform, status])
  @@index([productId])
  @@index([socialAccountId])
  @@map("shop_listings")
}

model Conversation {
  id        String             @id @default(cuid())
  subject   String?
  userId    String?
  email     String?
  status    ConversationStatus @default(OPEN)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User?              @relation(fields: [userId], references: [id])
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderType     MessageSenderType
  body           String
  readAt         DateTime?
  createdAt      DateTime          @default(now())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model AbandonedCart {
  id            String    @id @default(cuid())
  userId        String?
  guestEmail    String?
  cartData      Json
  recoveryToken String    @unique @default(cuid())
  recoveredAt   DateTime?
  emailStage    Int       @default(0)
  emailSent     Boolean   @default(false)
  emailSentAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([userId])
  @@index([guestEmail])
  @@index([emailSent, emailStage, createdAt])
  @@map("abandoned_carts")
}

model DiscountCode {
  id             String          @id @default(cuid())
  code           String          @unique
  description    String?
  type           DiscountType
  value          Decimal         @db.Decimal(10, 2)
  maxUses        Int?
  usedCount      Int             @default(0)
  maxUsesPerUser Int?
  minPurchase    Decimal?        @db.Decimal(10, 2)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String?
  createdBy      User?           @relation(fields: [createdById], references: [id])
  usages         DiscountUsage[]

  @@index([code])
  @@index([isActive, expiresAt])
  @@map("discount_codes")
}

model DiscountUsage {
  id             String       @id @default(cuid())
  discountCodeId String
  orderId        String
  userId         String?
  discountAmount Decimal      @db.Decimal(10, 2)
  orderTotal     Decimal      @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([discountCodeId])
  @@index([userId])
  @@index([orderId])
  @@map("discount_usages")
}

model LoyaltyAccount {
  id             String             @id @default(cuid())
  userId         String             @unique
  pointsBalance  Int                @default(0)
  lifetimePoints Int                @default(0)
  tier           LoyaltyTier        @default(BRONZE)
  tierUpdatedAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   PointTransaction[]
  rewards        RewardRedemption[]

  @@map("loyalty_accounts")
}

model PointTransaction {
  id          String               @id @default(cuid())
  accountId   String
  type        PointTransactionType
  points      Int
  description String
  orderId     String?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  account     LoyaltyAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("point_transactions")
}

model LoyaltyReward {
  id             String             @id @default(cuid())
  name           String
  description    String
  pointsCost     Int
  rewardType     String
  rewardValue    Decimal?           @db.Decimal(10, 2)
  isActive       Boolean            @default(true)
  minimumTier    LoyaltyTier        @default(BRONZE)
  maxRedemptions Int?
  usedCount      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  redemptions    RewardRedemption[]

  @@map("loyalty_rewards")
}

model RewardRedemption {
  id           String         @id @default(cuid())
  accountId    String
  rewardId     String
  pointsSpent  Int
  status       String
  discountCode String?
  expiresAt    DateTime?
  usedAt       DateTime?
  createdAt    DateTime       @default(now())
  account      LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reward       LoyaltyReward  @relation(fields: [rewardId], references: [id])

  @@index([accountId])
  @@index([status])
  @@index([expiresAt])
  @@map("reward_redemptions")
}

model Order {
  id                       String                 @id @default(cuid())
  orderNumber              String                 @unique
  userId                   String?
  guestEmail               String?
  guestPhone               String?
  shippingAddressId        String?
  billingAddressId         String?
  status                   OrderStatus            @default(PENDING)
  subtotal                 Decimal                @db.Decimal(10, 2)
  shippingCost             Decimal                @default(0) @db.Decimal(10, 2)
  tax                      Decimal                @default(0) @db.Decimal(10, 2)
  discountAmount           Decimal                @default(0) @db.Decimal(10, 2)
  // Codes applied at checkout. Recorded on the order so that completion (which may run
  // in the Stripe webhook, with no request context) knows what to redeem. Redemption is
  // deferred to payment success so an abandoned checkout cannot burn a gift balance or
  // consume a discount's usage allowance.
  discountCode             String?
  giftCertificateCode      String?
  giftCertificateAmount    Decimal                @default(0) @db.Decimal(10, 2)
  total                    Decimal                @db.Decimal(10, 2)
  shippingMethod           String?
  trackingNumber           String?
  estimatedDelivery        DateTime?
  actualDelivery           DateTime?
  shippingLabelUrl         String?
  easypostShipmentId       String?
  carrierName              String?
  trackingUrl              String?
  lastTrackingUpdate       DateTime?
  trackingHistory          Json?
  packingSlipUrl           String?
  invoiceUrl               String?
  invoiceSentAt            DateTime?
  modificationHistory      Json?
  paymentStatus            PaymentStatus          @default(PENDING)
  paymentMethod            String?
  stripePaymentId          String?
  customerNotes            String?
  adminNotes               String?
  shopifyOrderId           String?                @unique
  shopifyOrderName         String?
  shopifyFinancialStatus   String?
  shopifyFulfillmentStatus String?
  shopifySyncedAt          DateTime?
  shopifySyncError         String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  shippedAt                DateTime?
  deliveredAt              DateTime?
  confirmationEmailSentAt  DateTime?
  fundraiserId             String?
  importSource             String?
  importBatchId            String?
  importedAt               DateTime?
  printedInvoiceAt         DateTime?
  printedPackingSlipAt     DateTime?
  participantId            String?
  paymentChannel           PaymentChannel?        @default(ONLINE)
  paymentProvider          PaymentProvider?       @default(STRIPE)
  providerPaymentId        String?
  abandonedCartId          String?
  supportMessages          FundraiserMessage[]
  giftCertificateUsages    GiftCertificateUsage[]
  giftCertificates         GiftCertificate[]
  items                    OrderItem[]
  billingAddress           Address?               @relation("BillingAddress", fields: [billingAddressId], references: [id])
  fundraiser               Fundraiser?            @relation(fields: [fundraiserId], references: [id])
  participant              FundraiserParticipant? @relation(fields: [participantId], references: [id])
  shippingAddress          Address?               @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  user                     User?                  @relation(fields: [userId], references: [id])
  abandonedCart            AbandonedCart?         @relation(fields: [abandonedCartId], references: [id])
  payments                 Payment[]
  shippingLabels           ShippingLabel[]

  @@index([userId])
  @@index([participantId])
  @@index([abandonedCartId])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  totalPrice   Decimal  @db.Decimal(10, 2)
  productName  String
  productSku   String
  productImage String?
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                       String           @id @default(cuid())
  stripePaymentIntentId    String?          @unique
  stripeCheckoutSessionId  String?          @unique
  amount                   Int
  currency                 String           @default("usd")
  status                   PaymentStatus    @default(PENDING)
  paymentMethod            String?
  orderId                  String
  metadata                 Json?
  stripeCustomerId         String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  paidAt                   DateTime?
  channel                  PaymentChannel?  @default(ONLINE)
  methodType               String?
  paypalCaptureId          String?          @unique
  paypalOrderId            String?          @unique
  provider                 PaymentProvider? @default(STRIPE)
  providerPaymentId        String?
  squarePaymentId          String?          @unique
  squareTerminalCheckoutId String?          @unique
  order                    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds                  Refund[]

  @@index([orderId])
  @@index([status])
  @@index([provider])
  @@map("payments")
}

model Refund {
  id             String       @id @default(cuid())
  stripeRefundId String       @unique
  amount         Int
  reason         String?
  status         RefundStatus @default(PENDING)
  paymentId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  processedAt    DateTime?
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

model PaymentProviderConfig {
  id               String          @id @default(cuid())
  provider         PaymentProvider @unique
  isActive         Boolean         @default(false)
  credentials      Json?
  config           Json?
  supportedMethods String[]
  testMode         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("payment_provider_configs")
}

model WebhookEvent {
  id              String           @id @default(cuid())
  stripeEventId   String?          @unique
  type            String
  processed       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  provider        PaymentProvider? @default(STRIPE)
  providerEventId String?

  @@index([processed])
  @@index([providerEventId])
  @@map("webhook_events")
}

model Review {
  id          String       @id @default(cuid())
  userId      String
  productId   String
  rating      Int
  title       String?
  comment     String?
  isVerified  Boolean      @default(false)
  status      ReviewStatus @default(PENDING)
  moderatedAt DateTime?
  moderatedBy String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("reviews")
}

model SiteReview {
  id                String       @id @default(cuid())
  rating            Int
  comment           String?
  name              String?
  email             String?
  source            String?
  forwardedToGoogle Boolean      @default(false)
  status            ReviewStatus @default(PENDING)
  moderatedAt       DateTime?
  moderatedBy       String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@map("site_reviews")
}

model ChatThread {
  id              String               @id @default(cuid())
  status          ChatThreadStatus     @default(WAITING)
  source          String?
  customerName    String?
  customerEmail   String?
  customerUserId  String?
  ipAddress       String?
  userAgent       String?
  assignedAdminId String?
  startedAt       DateTime             @default(now())
  lastMessageAt   DateTime             @default(now())
  closedAt        DateTime?
  closedReason    String?
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  messages        ChatHandoffMessage[]

  @@index([status])
  @@index([assignedAdminId])
  @@index([lastMessageAt])
  @@index([startedAt])
  @@map("chat_threads")
}

model ChatHandoffMessage {
  id           String            @id @default(cuid())
  threadId     String
  senderType   ChatMessageSender
  senderUserId String?
  senderLabel  String?
  content      String
  createdAt    DateTime          @default(now())
  thread       ChatThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("chat_handoff_messages")
}

model Fundraiser {
  id                   String                  @id @default(cuid())
  name                 String
  slug                 String                  @unique
  description          String?
  organizationName     String
  contactEmail         String
  contactPhone         String?
  startDate            DateTime
  endDate              DateTime
  goal                 Decimal?                @db.Decimal(10, 2)
  commissionRate       Decimal                 @db.Decimal(5, 2)
  status               FundraiserStatus        @default(DRAFT)
  isActive             Boolean                 @default(false)
  totalOrders          Int                     @default(0)
  totalRevenue         Decimal                 @default(0) @db.Decimal(10, 2)
  totalCommission      Decimal                 @default(0) @db.Decimal(10, 2)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  subdomain            String?                 @unique
  pageConfig           Json?
  logoUrl              String?
  coverPhotoUrl        String?
  missionStatement     String?
  bio                  String?
  enableSocialFeatures Boolean                 @default(true)
  accessUsers          FundraiserAccess[]
  account              FundraiserAccount?
  analytics            FundraiserAnalytics?
  gamification         FundraiserGamification?
  messages             FundraiserMessage[]
  participants         FundraiserParticipant[]
  products             FundraiserProduct[]
  profile              FundraiserProfile?
  gamificationActions  GamificationAction[]
  orders               Order[]

  @@map("fundraisers")
}

model FundraiserMessage {
  id           String     @id @default(cuid())
  fundraiserId String
  content      String
  authorName   String
  authorEmail  String?
  authorAvatar String?
  authorId     String?
  isApproved   Boolean    @default(true)
  isHidden     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  orderId      String?
  author       User?      @relation(fields: [authorId], references: [id])
  fundraiser   Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  order        Order?     @relation(fields: [orderId], references: [id])

  @@index([fundraiserId, isHidden])
  @@index([orderId])
  @@map("fundraiser_messages")
}

model FundraiserChampionship {
  id                   String            @id @default(cuid())
  month                Int
  year                 Int
  winningFundraiserId  String
  winningParticipantId String?
  prizeAmount          Decimal           @db.Decimal(10, 2)
  scholarshipAmount    Decimal           @db.Decimal(10, 2)
  createdAt            DateTime          @default(now())
  seasonId             String?
  season               FundraiserSeason? @relation("SeasonChampionships", fields: [seasonId], references: [id])

  @@unique([month, year])
  @@index([seasonId])
  @@map("fundraiser_championships")
}

model FundraiserProduct {
  id           String     @id @default(cuid())
  fundraiserId String
  productId    String
  price        Decimal?   @db.Decimal(10, 2)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  fundraiser   Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([fundraiserId, productId])
  @@map("fundraiser_products")
}

model FundraiserParticipant {
  id              String                      @id @default(cuid())
  fundraiserId    String
  name            String
  email           String
  phone           String?
