/// Stock ordered from a supplier, and the record of what actually turned up.
model PurchaseOrder {
  id           String                 @id @default(cuid())
  poNumber     String                 @unique
  supplierId   String
  status       PurchaseOrderStatus    @default(DRAFT)
  expectedAt   DateTime?
  submittedAt  DateTime?
  receivedAt   DateTime?
  cancelledAt  DateTime?
  shippingCost Decimal                @default(0) @db.Decimal(10, 2)
  notes        String?
  createdById  String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  supplier     Supplier               @relation(fields: [supplierId], references: [id])
  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items        PurchaseOrderItem[]
  receipts     PurchaseOrderReceipt[]

  @@index([status])
  @@index([supplierId])
  @@index([expectedAt])
  @@map("purchase_orders")
}

/// One product line on a purchase order.
///
/// `quantityReceived` is a cached rollup of this line's receipt items and must only ever be
/// changed by the receiving path, which writes both in one transaction. Setting it directly
/// breaks the invariant that it equals the sum of `receiptItems.quantity`.
model PurchaseOrderItem {
  id               String                     @id @default(cuid())
  purchaseOrderId  String
  productId        String
  quantityOrdered  Int
  quantityReceived Int                        @default(0)
  unitCost         Decimal                    @db.Decimal(10, 2)
  purchaseOrder    PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product                    @relation(fields: [productId], references: [id])
  receiptItems     PurchaseOrderReceiptItem[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_items")
}

/// One delivery against a purchase order. A PO may be filled by several.
model PurchaseOrderReceipt {
  id              String                     @id @default(cuid())
  purchaseOrderId String
  /// Packing slip or supplier invoice number, so a receipt can be matched to paperwork.
  reference       String?
  notes           String?
  receivedById    String?
  receivedAt      DateTime                   @default(now())
  createdAt       DateTime                   @default(now())
  purchaseOrder   PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy      User?                      @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  items           PurchaseOrderReceiptItem[]

  @@index([purchaseOrderId])
  @@map("purchase_order_receipts")
}

model PurchaseOrderReceiptItem {
  id                  String               @id @default(cuid())
  receiptId           String
  purchaseOrderItemId String
  quantity            Int
  receipt             PurchaseOrderReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
