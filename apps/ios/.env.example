# Stripe publishable key (safe for client-side use).
# Get your key from https://dashboard.stripe.com/apikeys
#
# Use pk_test_... for development, pk_live_... for production.
# The key is injected into the Expo build via app.config.ts extra fields
# and read at runtime through expo-constants.
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# EAS project ID (optional, for Expo Application Services builds).
EAS_PROJECT_ID=
