{
  "name": "jose-madrid-platform",
  "version": "2.1.0",
  "projectVersion": "2.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "!apps/fundraiser-app",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@jose-madrid/storefront --env-mode=loose",
    "dev:all": "turbo run dev --env-mode=loose",
    "dev:fast": "npm run dev:fast --workspace=@jose-madrid/storefront",
    "dev:debug": "npm run dev:debug --workspace=@jose-madrid/storefront",
    "dev:storefront": "turbo run dev --filter=@jose-madrid/storefront --env-mode=loose",
    "dev:fundraising": "turbo run dev --filter=@jose-madrid/fundraising --env-mode=loose",
    "dev:admin": "turbo run dev --filter=@jose-madrid/admin --env-mode=loose",
    "dev:docs": "turbo run dev --filter=@jose-madrid/docs --env-mode=loose",
    "start": "npm run start --workspace=@jose-madrid/storefront",
    "build": "turbo run build --filter=!@jose-madrid/agent --env-mode=loose",
    "lint": "turbo run lint --env-mode=loose",
    "type-check": "turbo run type-check --env-mode=loose",
    "test": "turbo run test --env-mode=loose",
    "test:coverage": "turbo run test --env-mode=loose -- --coverage",
    "test:e2e": "npm exec --workspace=@jose-madrid/storefront playwright test",
    "clean": "turbo run clean && rm -rf .turbo",
    "version:feature": "npm run version:feature --workspace=@jose-madrid/storefront",
    "version:increment": "npm run version:increment --workspace=@jose-madrid/storefront",
    "version:major": "npm run version:major --workspace=@jose-madrid/storefront",
    "db:generate": "npm run db:generate --workspace=@jose-madrid/storefront",
    "db:migrate": "npm run db:migrate --workspace=@jose-madrid/storefront",
    "db:seed": "npm run db:seed --workspace=@jose-madrid/storefront",
    "db:deploy": "npm run db:deploy --workspace=@jose-madrid/storefront",
    "db:reset": "npm run db:reset --workspace=@jose-madrid/storefront",
    "db:studio": "npm run db:studio --workspace=@jose-madrid/storefront",
    "vercel-build": "npm run vercel-build --workspace=@jose-madrid/storefront",
    "security:scan": "npm run security:scan --workspace=@jose-madrid/storefront",
    "security:protect": "npm run security:protect --workspace=@jose-madrid/storefront",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/ui": "5.0.1",
    "husky": "^8.0.3",
    "turbo": "^2.5.4",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@tootallnate/once@<2.0.1": "2.0.1",
    "ajv@>=7.0.0 <8.18.0": "8.20.0",
    "brace-expansion@>=1.0.0 <1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
    "dompurify@>=3.4.13 <3.4.16": "3.4.16",
    "effect": "3.21.0",
    "esbuild@>=0.27.3 <0.28.1": "0.28.1",
    "fast-uri": "3.1.8",
    "google-auth-library": "10.9.1",
    "@grpc/grpc-js@>=1.14.0 <1.14.5": "1.14.5",
    "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "minimatch@>=10.0.0 <10.2.3": "10.2.5",
    "nanoid": "3.3.18",
    "path-to-regexp@>=4.0.0 <6.3.0": "6.3.0",
    "path-to-regexp@>=8.0.0 <8.4.0": "8.4.2",
    "postcss@>=8.0.0 <8.5.12": "8.5.15",
    "sharp@<0.35.0": "0.35.0",
    "smol-toml@<1.6.1": "1.8.0",
    "srvx@<0.11.13": "0.11.13",
    "tar@>=7.0.0 <7.5.21": "7.5.22",
    "undici@>=5.0.0 <6.28.1": "6.28.1",
    "undici@>=7.0.0 <7.29.1": "7.29.1",
    "undici@>=8.0.0 <8.10.2": "8.10.2",
    "uuid@>=7.0.0 <11.0.0": "11.1.1",
    "ws@>=7.0.0 <7.5.11": "7.5.11"
  },
  "packageManager": "npm@11.12.1"
}
