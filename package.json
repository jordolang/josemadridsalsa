{
  "name": "josemadrid-salsa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:fast": "next dev --turbo --port 3000",
    "dev:debug": "next dev --turbo --inspect",
    "prebuild": "node scripts/sync-findus.js",
    "build": "cross-env NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:recipes": "tsx scripts/seed-recipes.ts",
    "db:seed:nutrition": "tsx scripts/seed-nutrition-ingredients.ts",
    "db:seed:email-templates": "tsx scripts/seed-email-templates.ts",
    "locations:import": "tsx scripts/import-locations-from-markdown.ts",
    "locations:verify": "tsx scripts/verify-locations.ts",
    "locations:photos": "node scripts/generate-location-photos.js",
    "locations:update-photos": "node scripts/update-location-photos.mjs",
    "locations:geocode": "tsx scripts/backfill-location-coordinates.ts",
    "templates:backfill-owners": "tsx scripts/backfill-form-template-owners.ts",
    "api-keys:create": "tsx scripts/create-partner-api-key.ts",
    "products:transform": "tsx scripts/transform-products-csv.ts",
    "products:ensure-category": "tsx scripts/ensure-salsa-category.ts",
    "products:test-import": "tsx scripts/test-csv-import.ts",
    "shopify:test-webhook": "tsx scripts/test-shopify-webhook.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:production:sync": "node scripts/sync-production-schema.js",
    "db:production:seed": "node scripts/seed-production.js",
    "db:production:pull-env": "vercel env pull .env.vercel.production --environment=production --yes",
    "db:diagnose": "node scripts/diagnose-db-connection.js",
    "vercel:setup-env": "bash scripts/setup-vercel-env.sh",
    "create-admin": "tsx scripts/create-admin.ts",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "fresh": "npm run clean && npm install && npm run dev",
    "prepare": "husky install",
    "security:scan": "gitleaks detect --source . --verbose --redact",
    "security:protect": "gitleaks protect --verbose --redact --staged",
    "security:baseline": "gitleaks detect --source . --verbose --report-format json --report-path gitleaks-report.json",
    "pre-commit": "lint-staged && npm run security:protect",
    "analyze": "tsx scripts/analyze-project.ts",
    "analyze:watch": "tsx scripts/analyze-project.ts --watch",
    "analyze:report": "tsx scripts/analyze-project.ts --export markdown",
    "auto-execute": "tsx scripts/auto-execute-session.ts",
    "db:deploy": "prisma migrate deploy",
    "vercel-build": "prisma migrate deploy && prisma generate && tsx prisma/seed.permissions.ts && next build",
    "db:sync": "prisma db push --skip-generate --accept-data-loss"
  },
  "keywords": [
    "salsa",
    "e-commerce",
    "food",
    "next.js",
    "typescript"
  ],
  "author": "Jose Madrid Salsa",
  "license": "MIT",
  "dependencies": {
    "@amplitude/analytics-browser": "^2.33.1",
    "@amplitude/plugin-session-replay-browser": "^1.25.5",
    "@anthropic-ai/sdk": "^0.71.2",
    "@auth/prisma-adapter": "^2.11.0",
    "@clerk/nextjs": "^7.0.6",
    "@google-analytics/data": "^5.2.1",
    "@googleapis/calendar": "^14.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@openai/codex-sdk": "^0.57.0",
    "@prisma/client": "^6.19.2",
    "@prisma/extension-accelerate": "^2.0.2",
    "@prisma/extension-optimize": "^2.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^1.0.3",
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/nextjs": "^10.43.0",
    "@stripe/react-stripe-js": "^5.2.0",
    "@stripe/stripe-js": "^8.0.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^7.0.4",
    "@uploadthing/react": "^7.3.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/blob": "^0.24.1",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.25",
    "google-auth-library": "^10.6.1",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.555.0",
    "mammoth": "^1.11.0",
    "next": "16.2.1",
    "next-auth": "^4.24.11",
    "next-intl": "^4.7.0",
    "nodemailer": "^8.0.4",
    "p-limit": "^7.2.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.64.0",
    "react-is": "^19.2.4",
    "recharts": "^3.7.0",
    "resend": "^6.3.0",
    "shebang-regex": "^4.0.0",
    "sonner": "^2.0.7",
    "stripe": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "uploadthing": "^7.7.4",
    "workflow": "^4.2.0-beta.65",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.4",
    "@types/papaparse": "^5.5.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.6",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.19",
    "cheerio": "^1.1.2",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "fast-check": "^4.6.0",
    "fast-glob": "^3.3.2",
    "glob": "^13.0.0",
    "global-agent": "^3.0.0",
    "husky": "^8.0.3",
    "jsdom": "^28.1.0",
    "lighthouse": "^13.0.1",
    "lint-staged": "^15.2.0",
    "min-indent": "^1.0.1",
    "msw": "^2.12.10",
    "postcss": "^8.5.6",
    "prisma": "6.19.0",
    "react-email": "^5.2.9",
    "readdirp": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vercel": "^50.28.0",
    "vitest": "^4.0.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "tar": ">=7.5.10",
    "@tootallnate/once": ">=3.0.1",
    "minimatch": ">=10.2.3"
  },
  "resolutions": {
    "next": "16.2.1",
    "fast-xml-parser": ">=5.3.6",
    "prismjs": ">=1.30.0"
  }
}
