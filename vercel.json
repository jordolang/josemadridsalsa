{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/generate-game-icons-manifest.mjs && npm run vercel-build",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/abandoned-cart",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/review-requests",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/email-automation",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/email-campaigns",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/dashboard-analysis",
      "schedule": "0 6 * * *"
    }
  ]
}
