hub.com/date-fns/date-fns/pull/2941","line":25},{"title":"Fixed long formatters in the South African English locale (`en-ZA`).","target":"https://github.com/date-fns/date-fns/pull/3014","line":27},{"title":"Fixed a typo in the Icelandic locale (`is`) for `format`.","target":"https://github.com/date-fns/date-fns/pull/2974","line":29},{"title":"Fixed weekday format for `formatRelative` in the Portuguese locale (`pt`).","target":"https://github.com/date-fns/date-fns/pull/2992","line":31},{"title":"Fixed `intervalToDuration` being off by 1 day sometimes.","target":"https://github.com/date-fns/date-fns/pull/2616","line":33},{"title":"Fixed ordinal number formatting in Italian locale (`it`).","target":"https://github.com/date-fns/date-fns/pull/1617","line":35},{"title":"Fixed issue parsing months in Croatian (`hr`), Georgian (`ka`) and Serbian (`sr` and `sr-Latn`) locales.","target":"https://github.com/date-fns/date-fns/pull/2898","line":37},{"title":"Replaced `git.io` links with full URLs in error messages.","target":"https://github.com/date-fns/date-fns/pull/3021","line":41},{"title":"_Internal_: removed \"v2.0.0 breaking changes\" section from individual function docs","target":"https://github.com/date-fns/date-fns/pull/2905","line":43}],"class_name":"SmartBlock","last_embed":{"hash":"5bgbcv","at":1770841651794}},
