
"smart_sources:node_modules/colorette/README.md": {"path":"node_modules/colorette/README.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"ku22eq","at":1770841318858},"class_name":"SmartSource","last_import":{"mtime":1766767574981,"size":4200,"at":1770841318986,"hash":"ku22eq"},"blocks":{"#🌈Colorette":[1,135],"#🌈Colorette#{1}":[3,4],"#🌈Colorette#{2}":[5,5],"#🌈Colorette#{3}":[6,6],"#🌈Colorette#{4}":[7,7],"#🌈Colorette#{5}":[8,8],"#🌈Colorette#{6}":[9,9],"#🌈Colorette#{7}":[10,11],"#🌈Colorette#{8}":[12,13],"#🌈Colorette#Quickstart":[14,52],"#🌈Colorette#Quickstart#{1}":[16,52],"#🌈Colorette#Installation":[53,58],"#🌈Colorette#Installation#{1}":[55,58],"#🌈Colorette#API":[59,84],"#🌈Colorette#API#\\<color\\>()":[61,70],"#🌈Colorette#API#\\<color\\>()#{1}":[63,70],"#🌈Colorette#API#createColors()":[71,80],"#🌈Colorette#API#createColors()#{1}":[73,80],"#🌈Colorette#API#isColorSupported":[81,84],"#🌈Colorette#API#isColorSupported#{1}":[83,84],"#🌈Colorette#Environment":[85,98],"#🌈Colorette#Environment#{1}":[87,98],"#🌈Colorette#Supported colors":[99,112],"#🌈Colorette#Supported colors#{1}":[101,112],"#🌈Colorette#[Benchmarks](https://github.com/jorgebucaran/colorette/actions/workflows/bench.yml)":[113,127],"#🌈Colorette#[Benchmarks](https://github.com/jorgebucaran/colorette/actions/workflows/bench.yml)#{1}":[115,127],"#🌈Colorette#Acknowledgments":[128,131],"#🌈Colorette#Acknowledgments#{1}":[130,131],"#🌈Colorette#License":[132,135],"#🌈Colorette#License#{1}":[134,135]},"outlinks":[{"title":"2x faster","target":"#benchmarks","line":7},{"title":"`NO_COLOR`","target":"https://no-color.org","line":9},{"title":"**Upgrading from Colorette `1.x`?**","target":"https://github.com/jorgebucaran/colorette/issues/70","line":12},{"title":"template literals","target":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Template_literals","line":26},{"title":"supported colors","target":"#supported-colors","line":63},{"title":"34mI'm blue\\x1b[39m\n```\n\n### createColors()\n\nOverride terminal color detection via `createColors({ useColor })`.\n\n```js\nimport { createColors } from \"colorette\"\n\nconst { blue } = createColors({ useColor: false })\n```\n\n### isColorSupported\n\n`true` if your terminal supports color, `false` otherwise. Used internally, but exposed for convenience.\n\n## Environment\n\nYou can override color detection from the CLI by setting the `--no-color` or `--color` flags.\n\n```console\n$ ./example.js --no-color | ./consumer.js\n```\n\nOr if you can't use CLI flags, by setting the `NO_COLOR=` or `FORCE_COLOR=` environment variables.\n\n```console\n$ NO_COLOR= ./example.js | ./consumer.js\n```\n\n## Supported colors\n\n| Colors  | Background Colors | Bright Colors | Bright Background Colors | Modifiers         |\n| ------- | ----------------- | ------------- | ------------------------ | ----------------- |\n| black   | bgBlack           | blackBright   | bgBlackBright            | dim               |\n| red     | bgRed             | redBright     | bgRedBright              | **bold**          |\n| green   | bgGreen           | greenBright   | bgGreenBright            | hidden            |\n| yellow  | bgYellow          | yellowBright  | bgYellowBright           | _italic_          |\n| blue    | bgBlue            | blueBright    | bgBlueBright             | <u>underline</u>  |\n| magenta | bgMagenta         | magentaBright | bgMagentaBright          | ~~strikethrough~~ |\n| cyan    | bgCyan            | cyanBright    | bgCyanBright             | reset             |\n| white   | bgWhite           | whiteBright   | bgWhiteBright            |                   |\n| gray    |                   |               |                          |                   |\n\n## [Benchmarks","target":"https://github.com/jorgebucaran/colorette/actions/workflows/bench.yml","line":68},{"title":"@alexeyraspopov","target":"https://github.com/alexeyraspopov","line":130},{"title":"picocolors","target":"https://github.com/alexeyraspopov/picocolors","line":130},{"title":"Chalk","target":"https://github.com/chalk/chalk","line":130},{"title":"@jorgebucaran","target":"https://github.com/jorgebucaran","line":130},{"title":"Clor","target":"https://github.com/jorgebucaran/colorette/commit/b01b5b9961ceb7df878583a3002e836fae9e37ce","line":130},{"title":"@Qix-","target":"https://github.com/Qix-","line":130},{"title":"@sindresorhus","target":"https://github.com/sindresorhus","line":130},{"title":"MIT","target":"LICENSE.md","line":134}],"task_lines":[],"tasks":{},"codeblock_ranges":[[16,24],[28,35],[39,41],[45,51],[55,57],[65,69],[75,79],[89,91],[95,97],[115,117],[119,126]]},
