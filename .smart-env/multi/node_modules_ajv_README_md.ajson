/objection.js","line":1439},{"title":"table","target":"https://github.com/gajus/table","line":1440},{"title":"ripple-lib","target":"https://github.com/ripple/ripple-lib","line":1441},{"title":"Ripple","target":"https://ripple.com","line":1441},{"title":"restbase","target":"https://github.com/wikimedia/restbase","line":1442},{"title":"hippie-swagger","target":"https://github.com/CacheControl/hippie-swagger","line":1443},{"title":"Hippie","target":"https://github.com/vesln/hippie","line":1443},{"title":"react-form-controlled","target":"https://github.com/seeden/react-form-controlled","line":1444},{"title":"rabbitmq-schema","target":"https://github.com/tjmehta/rabbitmq-schema","line":1445},{"title":"@query/schema","target":"https://www.npmjs.com/package/@query/schema","line":1446},{"title":"chai-ajv-json-schema","target":"https://github.com/peon374/chai-ajv-json-schema","line":1447},{"title":"grunt-jsonschema-ajv","target":"https://github.com/SignpostMarv/grunt-jsonschema-ajv","line":1448},{"title":"extract-text-webpack-plugin","target":"https://github.com/webpack-contrib/extract-text-webpack-plugin","line":1449},{"title":"electron-builder","target":"https://github.com/electron-userland/electron-builder","line":1450},{"title":"addons-linter","target":"https://github.com/mozilla/addons-linter","line":1451},{"title":"gh-pages-generator","target":"https://github.com/epoberezkin/gh-pages-generator","line":1452},{"title":"ESLint","target":"https://github.com/eslint/eslint","line":1453},{"title":"dot","target":"https://github.com/ajv-validator/ajv/tree/master/lib/dot","line":1466},{"title":"dotjs","target":"https://github.com/ajv-validator/ajv/tree/master/lib/dotjs","line":1468},{"title":"Contributing guidelines","target":"https://github.com/ajv-validator/ajv/blob/master/CONTRIBUTING.md","line":1472},{"title":"Changes in version 7.0.0-beta","target":"https://github.com/ajv-validator/ajv/releases/tag/v7.0.0-beta.0","line":1479},{"title":"Version 6.0.0","target":"https://githu